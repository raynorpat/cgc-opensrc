// Standard library for CG
// The contents of this file will be automatically #included in a special
// global scope before every CG input file
//
// The Cg 2.0 intrinsics are installed declaratively by the compiler
// itself (cg_stdlib.def / cg_stdlib.c) before this file parses, so only
// portable function bodies whose implementation is itself valid Cg
// remain here.  Canonical scalar, vector, and float matrix type
// spellings are likewise predefined language types.
//
// Token-stream note: this source must stay free of double-precision
// and greater-than-32-bit integer literals -- the 4-byte stdlib token
// record cannot represent them.  It currently contains no numeric
// literals at all, so the recorded stream is exact.

#ifdef PROFILE_GLSLV
#define PROFILE_GLSL 1
#endif
#ifdef PROFILE_GLSLF
#define PROFILE_GLSL 1
#endif
#ifdef PROFILE_HLSLV
#define PROFILE_HLSL 1
#endif
#ifdef PROFILE_HLSLF
#define PROFILE_HLSL 1
#endif
#ifdef PROFILE_HLSLV40
#define PROFILE_HLSL 1
#endif
#ifdef PROFILE_HLSLG40
#define PROFILE_HLSL 1
#endif
#ifdef PROFILE_HLSLF40
#define PROFILE_HLSL 1
#endif
#ifdef PROFILE_HLSLV50
#define PROFILE_HLSL 1
#endif
#ifdef PROFILE_HLSLG50
#define PROFILE_HLSL 1
#endif
#ifdef PROFILE_HLSLF50
#define PROFILE_HLSL 1
#endif

#ifdef PROFILE_HLSL

// trunc predates the declarative Cg 2.0 catalog.  Keep only its exact
// HLSL-supported overloads as source-level internal markers; every catalog
// intrinsic continues to resolve through cg_stdlib.def/cg_stdlib.c.

__internal float  trunc(float  x);
__internal float1 trunc(float1 x);
__internal float2 trunc(float2 x);
__internal float3 trunc(float3 x);
__internal float4 trunc(float4 x);

// DirectX 9 exposes bias and explicit-LOD texture forms as distinct
// intrinsics.  Base, projected, and gradient signatures come from the
// declarative Cg 2.0 catalog; only these HLSL-specific names need markers.

__internal float4 tex1Dlod(sampler1D image, float4 coord);
__internal float4 tex2Dlod(sampler2D image, float4 coord);
__internal float4 tex3Dlod(sampler3D image, float4 coord);
__internal float4 texCUBElod(samplerCUBE image, float4 coord);

#ifdef PROFILE_HLSLF
__internal float4 tex1Dbias(sampler1D image, float4 coord);
__internal float4 tex2Dbias(sampler2D image, float4 coord);
__internal float4 tex3Dbias(sampler3D image, float4 coord);
__internal float4 texCUBEbias(samplerCUBE image, float4 coord);
#endif

#ifdef PROFILE_HLSLF40
__internal float4 tex1Dbias(sampler1D image, float4 coord);
__internal float4 tex2Dbias(sampler2D image, float4 coord);
__internal float4 tex3Dbias(sampler3D image, float4 coord);
__internal float4 texCUBEbias(samplerCUBE image, float4 coord);
#endif

#ifdef PROFILE_HLSLF50
__internal float4 tex1Dbias(sampler1D image, float4 coord);
__internal float4 tex2Dbias(sampler2D image, float4 coord);
__internal float4 tex3Dbias(sampler3D image, float4 coord);
__internal float4 texCUBEbias(samplerCUBE image, float4 coord);
#endif

#endif /* PROFILE_HLSL */

#ifdef PROFILE_GLSL

// GLSL profiles lower catalog intrinsics by stable identity in
// glsl_lower.c; no source-level prototypes are needed.  The marker
// comments delimit the region stripped from the generic token stream
// during stdlib regeneration.

// CGC_GLSL_TEXTURES_BEGIN
// CGC_GLSL_TEXTURES_END

#else

float dot(float1 a, float1 b) { return a.x*b.x; }
float dot(float2 a, float2 b) { return a.x*b.x + a.y*b.y; }
float dot(float3 a, float3 b) { return a.x*b.x + a.y*b.y + a.z*b.z; }
float dot(float4 a, float4 b) { return a.x*b.x + a.y*b.y + a.z*b.z + a.w*b.w; }

float2 mul(float2x2 m, float2 v) {
    float2 rv;
    rv.x = dot(m._m00_m01, v);
    rv.y = dot(m._m10_m11, v);
    return rv;
}

float3 mul(float3x3 m, float3 v) {
    float3 rv;
    rv.x = dot(m._m00_m01_m02, v);
    rv.y = dot(m._m10_m11_m12, v);
    rv.z = dot(m._m20_m21_m22, v);
    return rv;
}

float4 mul(float4x4 m, float4 v) {
    float4 rv;
    rv.x = dot(m._m00_m01_m02_m03, v);
    rv.y = dot(m._m10_m11_m12_m13, v);
    rv.z = dot(m._m20_m21_m22_m23, v);
    rv.w = dot(m._m30_m31_m32_m33, v);
    return rv;
}

// Catalog rsqrt overloads gain vector wrappers written in portable Cg;
// the scalar form stays a pure catalog intrinsic.

float1 rsqrt(float1 x) {
    return float1(rsqrt(x.x));
}
float2 rsqrt(float2 x) {
    return float2(rsqrt(x.x), rsqrt(x.y));
}
float3 rsqrt(float3 x) {
    return float3(rsqrt(x.x), rsqrt(x.y), rsqrt(x.z));
}
float4 rsqrt(float4 x) {
    return float4(rsqrt(x.x), rsqrt(x.y), rsqrt(x.z), rsqrt(x.w));
}

// different profiles can have things defined for them specifically

#ifdef PROFILE_SPECIAL

float1 sin(float1 x) {
    return float1(sin(x.x));
}
float2 sin(float2 x) {
    return float2(sin(x.x), sin(x.y));
}
float3 sin(float3 x) {
    return float3(sin(x.x), sin(x.y), sin(x.z));
}
float4 sin(float4 x) {
    return float4(sin(x.x), sin(x.y), sin(x.z), sin(x.w));
}

#endif /* PROFILE_SPECIAL */

float1 normalize(float1 v) { return rsqrt(dot(v, v)) * v; }
float2 normalize(float2 v) { return rsqrt(dot(v, v)) * v; }
float3 normalize(float3 v) { return rsqrt(dot(v, v)) * v; }
float4 normalize(float4 v) { return rsqrt(dot(v, v)) * v; }

float  max(float  a, float  b) { return a>b ? a : b; }
float1 max(float1 a, float1 b) { return a>b ? a : b; }
float2 max(float2 a, float2 b) { return a>b ? a : b; }
float3 max(float3 a, float3 b) { return a>b ? a : b; }
float4 max(float4 a, float4 b) { return a>b ? a : b; }

#endif /* PROFILE_GLSL */


// different profiles can have things defined for them specifically

#ifdef PROFILE_ARBFP1

__internal float4 tex1D(sampler1D image, float coord);
__internal float4 tex1Dproj(sampler1D image, float2 coord);
__internal float4 tex1Dbias(sampler1D image, float4 coord);

__internal float4 tex2D(sampler2D image, float2 coord);
__internal float4 tex2Dproj(sampler2D image, float3 coord);
__internal float4 tex2Dproj(sampler2D image, float4 coord);
__internal float4 tex2Dbias(sampler2D image, float4 coord);

__internal float4 tex3D(sampler3D image, float3 coord);
__internal float4 tex3Dproj(sampler3D image, float4 coord);
__internal float4 tex3Dbias(sampler3D image, float4 coord);

__internal float4 texCUBE(samplerCUBE image, float3 coord);
__internal float4 texCUBEproj(samplerCUBE image, float4 coord);
__internal float4 texCUBEbias(samplerCUBE image, float4 coord);

__internal float4 texRECT(samplerRECT image, float2 coord);
__internal float4 texRECTproj(samplerRECT image, float3 coord);

#endif /* PROFILE_ARBFP1 */
