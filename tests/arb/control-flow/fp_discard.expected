!!ARBfp1.0
#vendor NVIDIA Corporation
#version 1.0
#profile arbfp1
#program main
#var float4 color : $vin.COLOR0 : COL0 : 0 : 1
#var float4 main : $vout.COLOR : COL : -1 : 1
TEMP R0;
TEMP R1;
PARAM literal0 = { 0.5, 0.5, 0.5, 0.5 };
PARAM literal1 = { 1, 1, 1, 1 };
SLT R0, fragment.color.primary.wwww, literal0;
SUB R1, R0.xxxx, literal1;
KIL R1;
MOV result.color, fragment.color.primary;
END
# 4 instructions, 2 R-regs
