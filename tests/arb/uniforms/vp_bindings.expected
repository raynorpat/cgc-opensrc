!!ARBvp1.0
#vendor NVIDIA Corporation
#version 1.0
#profile arbvp1
#program main
#semantic main.scale
#semantic main.tint
#semantic main.bias
#var float4 input.position : $vin.POSITION : POSITION : 0 : 1
#var float4 input.color : $vin.COLOR0 : COLOR0 : 0 : 1
#var float4 scale :  : c[4] : 1 : 1
#var float4 tint :  : c[0] : 2 : 1
#var float4 bias :  : c[1] : 3 : 1
#var float4 main.position : $vout.POSITION : HPOS : -1 : 1
#var float4 main.color : $vout.COLOR0 : COL0 : -1 : 1
#const c[1] = 0.1 0.2 0.3 0
#default  main.tint = 1 1 1 1
TEMP R0;
TEMP R1;
PARAM c[4] = { program.local[0..4] };
MUL R0, vertex.position, c[4];
MOV result.position, R0;
MUL R0, vertex.color.primary, c[0];
ADD R1, R0, c[1];
MOV result.color.front.primary, R1;
END
# 5 instructions, 2 R-regs
