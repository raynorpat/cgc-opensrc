!!ARBfp1.0
#vendor NVIDIA Corporation
#version 1.0
#profile arbfp1
#program main
#semantic main.threshold
#var float4 color : $vin.COLOR0 : COL0 : 0 : 1
#var float threshold :  : c[0] : 1 : 1
#var float4 main : $vout.COLOR : COL : -1 : 1
TEMP R0;
TEMP R1;
PARAM c[0] = { program.local[0..0] };
PARAM literal0 = { 0, 0, 0, 1 };
PARAM literal1 = { 1, 1, 1, 1 };
SGE R0, fragment.color.primary.wwww, c[0].xxxx;
SUB R1, R0.xxxx, literal1;
CMP R0, R1, fragment.color.primary, literal0;
MOV result.color, R0;
END
# 4 instructions, 2 R-regs
