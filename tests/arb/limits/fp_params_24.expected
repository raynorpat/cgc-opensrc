TEMP R0;
TEMP R1;
PARAM c[23] = { program.local[0..23] };
ADD R0, c[0], fragment.position;
MOV R1, R0;
ADD R0, c[23], R1;
MOV R1, R0;
MOV result.color, R1;
END
