!!ARBfp1.0
#vendor NVIDIA Corporation
#version 1.0
#profile arbfp1
#program main
#semantic main.image : TEXUNIT0
#var float2 texcoord : $vin.TEXCOORD0 : TEX0 : 0 : 1
#var sampler2D image : TEXUNIT0 : texunit 0 : 1 : 1
#var float4 main : $vout.COLOR : COL : -1 : 1
TEMP R0;
TEMP R1;
PARAM literal0 = { 0.5, 0.5, 0.5, 0.5 };
MUL R0, fragment.texcoord[0].xxyy, literal0.xxxx;
ADD R1, R0, fragment.texcoord[0].yyxx;
TEX R0, R1;
MOV result.color, R0;
END
# 4 instructions, 2 R-regs
