!!ARBvp1.0
#vendor NVIDIA Corporation
#version 1.0
#profile arbvp1
#program main
#var float4 input.position : $vin.POSITION : POSITION : 0 : 1
#var float4 input.a0 : $vin.ATTR0 : ATTR0 : 0 : 1
#var float4 input.a1 : $vin.ATTR1 : ATTR1 : 0 : 1
#var float4 input.a2 : $vin.ATTR2 : ATTR2 : 0 : 1
#var float4 input.a3 : $vin.ATTR3 : ATTR3 : 0 : 1
#var float4 input.a4 : $vin.ATTR4 : ATTR4 : 0 : 1
#var float4 input.a5 : $vin.ATTR5 : ATTR5 : 0 : 1
#var float4 input.t0 : $vin.ATTR8 : ATTR8 : 0 : 1
#var float4 input.t1 : $vin.ATTR9 : ATTR9 : 0 : 1
#var float4 input.t2 : $vin.ATTR10 : ATTR10 : 0 : 1
#var float4 input.t3 : $vin.ATTR11 : ATTR11 : 0 : 1
#var float4 main.position : $vout.POSITION : HPOS : -1 : 1
#var float4 main.c0 : $vout.COLOR0 : COL0 : -1 : 1
#var float4 main.c1 : $vout.COLOR1 : COL1 : -1 : 1
#var float4 main.b0 : $vout.BCOL0 : BFC0 : -1 : 1
#var float4 main.fog : $vout.FOG : FOGC : -1 : 1
#var float4 main.psiz : $vout.PSIZE : PSIZ : -1 : 1
#var float4 main.t0 : $vout.TEXCOORD0 : TEX0 : -1 : 1
TEMP R0;
TEMP R1;
ADD R0, vertex.attrib[0], vertex.attrib[1];
ADD R1, R0, vertex.attrib[2];
ADD R0, R1, vertex.attrib[3];
ADD R1, R0, vertex.attrib[4];
ADD R0, R1, vertex.attrib[5];
ADD R1, R0, vertex.attrib[8];
ADD R0, R1, vertex.attrib[9];
ADD R1, R0, vertex.attrib[10];
ADD R0, R1, vertex.attrib[11];
MOV result.position, R0;
MOV result.color.front.primary, result.position;
MOV result.color.front.secondary, result.position;
MOV result.color.back.primary, result.position;
MOV result.fogcoord, result.position;
MOV result.pointsize, result.position;
MOV result.texcoord[0], result.position;
END
# 16 instructions, 2 R-regs
