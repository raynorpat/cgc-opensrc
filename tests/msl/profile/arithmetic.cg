float twice(float x) { return x * 2.0; }
float4 main(void) : COLOR0
{
    int sum = 0;
    int i;
    int k = 0;
    for (i = 0; i < 4; i++) {
        if (i == 1) continue;
        sum += i;
    }
    do { k++; } while (k < 2);
    while (k < 4) { k++; if (k == 3) break; }
    return float4(twice(float(sum)) / 2.0, k, 0, 1);
}
