// profile hlslg40
// target gs_4_0
// cgc-bind interface out POSITION float4 SV_Position SV_Position system default
// cgc-bind interface in position float4 SV_Position SV_Position system default

struct cg_GeometryOut
{
    float4 position : SV_Position;
};

struct cg_GeometryIn
{
    float4 position : SV_Position;
};

float cg_bump(inout float value)
{
    value = value + (float) 1.0;
    return value;
}

void cg_entry(float4 position[1], inout PointStream<cg_GeometryOut> cgc_stream, inout cg_GeometryOut cgc_output)
{
    float value;
    int i;
    float temp1;
    float temp2;
    float temp3;
    float temp4;
    bool temp5;
    float temp6;
    float temp7;
    int temp8;
    float4 temp9;
    value = 0.0;
    i = 0;
    while (true)
    {
        temp1 = cg_bump(value);
        temp2 = temp1 + cg_bump(value);
        if (!(temp2 < 4.0))
        {
            break;
        }
        {
            if (value > 3.0)
            {
                continue;
            }
        }
    }
    temp5 = true;
    while (true)
    {
        if (!temp5)
        {
            temp3 = cg_bump(value);
            temp4 = temp3 + cg_bump(value);
            if (!(temp4 < 8.0))
            {
                break;
            }
        }
        temp5 = false;
        {
            value = value + 1.0;
        }
    }
    for (i = 0; ; temp8 = (int) cg_bump(value), i = temp8 + (int) cg_bump(value))
    {
        temp6 = cg_bump(value);
        temp7 = temp6 + cg_bump(value);
        if (!(temp7 < 12.0))
        {
            break;
        }
        {
            if (i > 20)
            {
                break;
            }
            if (i > 10)
            {
                continue;
            }
            value = value + 1.0;
        }
    }
    {
        temp9 = position[0] + float4(value, (float) i, 0.0, 0.0);
        cgc_output.position = temp9;
        cgc_stream.Append(cgc_output);
    }
}

[maxvertexcount(1)]
void main(point cg_GeometryIn input[1], inout PointStream<cg_GeometryOut> cgc_stream)
{
    float4 position[1];
    cg_GeometryOut cgc_output = (cg_GeometryOut) 0;
    position[0] = input[0].position;
    cg_entry(position, cgc_stream, cgc_output);
    return;
}
