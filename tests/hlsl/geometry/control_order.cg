// Conditional prefixes stay on their selected paths.

float bump(inout float value)
{
    value = value + 1.0;
    return value;
}

POINT POINT_OUT void main(AttribArray<float4> position : POSITION)
{
    float value = 0.0;
    bool choose = position[0].x > 0.0;
    float selected = choose ? bump(value) + bump(value)
                            : bump(value) + bump(value);
    emitVertex(position[0] +
               float4(selected, value, 0.0, 0.0)
               : POSITION);
}
