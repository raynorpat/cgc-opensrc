// profile hlslg40
// target gs_4_0
// cgc-bind interface in position float4 SV_Position SV_Position system default
// cgc-bind interface in instance uint SV_PrimitiveID SV_PrimitiveID system nointerpolation

struct cg_GeometryIn
{
    float4 position : SV_Position;
};

void cg_entry(float4 position[1], int instance)
{
    int copy;
    copy = instance;
}

void main(cg_GeometryIn input[1], nointerpolation uint instance : SV_PrimitiveID)
{
    float4 position[1];
    position[0] = input[0].position;
    cg_entry(position, (int) instance);
    return;
}
