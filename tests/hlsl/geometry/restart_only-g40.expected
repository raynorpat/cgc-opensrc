// compiler cgc
// profile hlslg40
// target gs_4_0
// entry main
struct cg_GeometryOut
{
    float cgc_placeholder : TEXCOORD0;
};

struct cg_GeometryIn
{
    float cgc_placeholder : TEXCOORD0;
};

void cg_entry(inout PointStream<cg_GeometryOut> cgc_stream, inout cg_GeometryOut cgc_output)
{
    cgc_stream.RestartStrip();
}

[maxvertexcount(1)]
void main(point cg_GeometryIn input[1], inout PointStream<cg_GeometryOut> cgc_stream)
{
    cg_GeometryOut cgc_output = (cg_GeometryOut) 0;
    cg_entry(cgc_stream, cgc_output);
    return;
}
