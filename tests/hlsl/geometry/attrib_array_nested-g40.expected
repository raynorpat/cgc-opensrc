// profile hlslg40
// target gs_4_0
// cgc-bind interface in position float4 SV_Position SV_Position system default
// cgc-bind interface in weights float2 ATTRIB0 ATTRIB0 user default
// cgc-bind interface in weights float2 ATTRIB1 ATTRIB1 user default
// cgc-bind interface in weights float2 ATTRIB2 ATTRIB2 user default
// cgc-bind interface in weights float2 ATTRIB3 ATTRIB3 user default
// cgc-bind interface in code int ATTRIB6 ATTRIB6 user nointerpolation

struct cg_GeometryOut
{
    float cgc_placeholder : TEXCOORD0;
};

struct cg_Nested
{
    int code;
};

struct cg_Vertex
{
    float4 position;
    float2 weights[2][2];
    cg_Nested nested;
};

struct cg_GeometryIn
{
    float4 vertices_position : SV_Position;
    float2 vertices_weights_0_0 : ATTRIB0;
    float2 vertices_weights_0_1 : ATTRIB1;
    float2 vertices_weights_1_0 : ATTRIB2;
    float2 vertices_weights_1_1 : ATTRIB3;
    nointerpolation int vertices_nested_code : ATTRIB6;
};

void cg_entry(cg_Vertex vertices[3])
{
    float weight;
    int code;
    weight = vertices[0].weights[1][0].x;
    code = vertices[2].nested.code;
}

[maxvertexcount(4)]
void main(triangle cg_GeometryIn input[3], inout TriangleStream<cg_GeometryOut> cgc_stream)
{
    cg_Vertex vertices[3];
    cg_GeometryOut cgc_output = (cg_GeometryOut) 0;
    vertices[0].position = input[0].vertices_position;
    vertices[1].position = input[1].vertices_position;
    vertices[2].position = input[2].vertices_position;
    vertices[0].weights[0][0] = input[0].vertices_weights_0_0;
    vertices[1].weights[0][0] = input[1].vertices_weights_0_0;
    vertices[2].weights[0][0] = input[2].vertices_weights_0_0;
    vertices[0].weights[0][1] = input[0].vertices_weights_0_1;
    vertices[1].weights[0][1] = input[1].vertices_weights_0_1;
    vertices[2].weights[0][1] = input[2].vertices_weights_0_1;
    vertices[0].weights[1][0] = input[0].vertices_weights_1_0;
    vertices[1].weights[1][0] = input[1].vertices_weights_1_0;
    vertices[2].weights[1][0] = input[2].vertices_weights_1_0;
    vertices[0].weights[1][1] = input[0].vertices_weights_1_1;
    vertices[1].weights[1][1] = input[1].vertices_weights_1_1;
    vertices[2].weights[1][1] = input[2].vertices_weights_1_1;
    vertices[0].nested.code = input[0].vertices_nested_code;
    vertices[1].nested.code = input[1].vertices_nested_code;
    vertices[2].nested.code = input[2].vertices_nested_code;
    cg_entry(vertices);
    return;
}
