// compiler cgc
// profile hlslg40
// target gs_4_0
// entry main
struct cg_GeometryOut
{
    float cgc_placeholder : TEXCOORD0;
};

struct cg_GeometryIn
{
    float cgc_placeholder : TEXCOORD0;
};

void cg_entry()
{
    return;
}

[maxvertexcount(1024)]
void main(point cg_GeometryIn input[1], inout PointStream<cg_GeometryOut> cgc_stream)
{
    cg_GeometryOut cgc_output = (cg_GeometryOut) 0;
    cg_entry();
    return;
}
