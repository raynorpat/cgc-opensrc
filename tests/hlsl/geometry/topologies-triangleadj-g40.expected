// profile hlslg40
// target gs_4_0
// cgc-bind interface in position float4 SV_Position SV_Position system default

struct cg_GeometryOut
{
    float cgc_placeholder : TEXCOORD0;
};

struct cg_GeometryIn
{
    float4 position : SV_Position;
};

void cg_entry(float4 position[6])
{
    return;
}

[maxvertexcount(4)]
void main(triangleadj cg_GeometryIn input[6], inout TriangleStream<cg_GeometryOut> cgc_stream)
{
    float4 position[6];
    cg_GeometryOut cgc_output = (cg_GeometryOut) 0;
    position[0] = input[0].position;
    position[1] = input[1].position;
    position[2] = input[2].position;
    position[3] = input[3].position;
    position[4] = input[4].position;
    position[5] = input[5].position;
    cg_entry(position);
    return;
}
