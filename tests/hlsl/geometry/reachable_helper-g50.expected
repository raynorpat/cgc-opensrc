// compiler cgc
// profile hlslg50
// target gs_5_0
// entry main
// cgc-bind interface out COLOR0 float4 COLOR0 COLOR0 user nointerpolation
// cgc-bind interface out POSITION float4 SV_Position SV_Position system default
// cgc-bind interface in position float4 SV_Position SV_Position system default

// cgc-bind uniform color float4 b0 c0.x byte=0 size=16 span=1 semantic=-

cbuffer cgc_Uniforms : register(b0)
{
    float4 cgc_color : packoffset(c0.x);
};

struct cg_GeometryOut
{
    nointerpolation float4 color0 : COLOR0;
    float4 position : SV_Position;
};

struct cg_GeometryIn
{
    float4 position : SV_Position;
};

void cg_leaf(float4 position, float4 color, inout PointStream<cg_GeometryOut> cgc_stream, inout cg_GeometryOut cgc_output, inout float4 cgc_flat_color0, inout bool cgc_flat_color0_defined);

void cg_middle(float4 position, float4 color, inout PointStream<cg_GeometryOut> cgc_stream, inout cg_GeometryOut cgc_output, inout float4 cgc_flat_color0, inout bool cgc_flat_color0_defined)
{
    cg_leaf(position, color, cgc_stream, cgc_output, cgc_flat_color0, cgc_flat_color0_defined);
    cgc_stream.RestartStrip();
}

void cg_leaf(float4 position, float4 color, inout PointStream<cg_GeometryOut> cgc_stream, inout cg_GeometryOut cgc_output, inout float4 cgc_flat_color0, inout bool cgc_flat_color0_defined)
{
    float4 temp1;
    float4 temp2;
    float4 temp3;
    {
        temp1 = color;
        cgc_flat_color0 = temp1;
        cgc_flat_color0_defined = true;
    }
    {
        temp2 = position;
        temp3 = color * (float) 0.5;
        cgc_output = (cg_GeometryOut) 0;
        cgc_output.position = temp2;
        cgc_output.color0 = temp3;
        if (cgc_flat_color0_defined)
        {
            cgc_output.color0 = cgc_flat_color0;
        }
        cgc_stream.Append(cgc_output);
    }
}

void cg_entry(float4 position[1], float4 color, inout PointStream<cg_GeometryOut> cgc_stream, inout cg_GeometryOut cgc_output, inout float4 cgc_flat_color0, inout bool cgc_flat_color0_defined)
{
    cg_middle(position[0], color, cgc_stream, cgc_output, cgc_flat_color0, cgc_flat_color0_defined);
}

[maxvertexcount(1)]
void main(point cg_GeometryIn input[1], inout PointStream<cg_GeometryOut> cgc_stream)
{
    float4 position[1];
    cg_GeometryOut cgc_output = (cg_GeometryOut) 0;
    float4 cgc_flat_color0 = float4(0.0, 0.0, 0.0, 0.0);
    bool cgc_flat_color0_defined = false;
    position[0] = input[0].position;
    cg_entry(position, cgc_color, cgc_stream, cgc_output, cgc_flat_color0, cgc_flat_color0_defined);
    return;
}
