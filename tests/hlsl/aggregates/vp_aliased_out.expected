// profile hlslv
// target vs_3_0
// cgc-bind interface in position float4 POSITION0
// cgc-bind interface out position float4 POSITION0

struct cg_Pair
{
    float4 values[2];
};

struct cg_VertexOut
{
    float4 position;
};

struct cg_VertexIn
{
    float4 position : POSITION0;
};

struct cg_VertexOut_1
{
    float4 position : POSITION0;
};

void cg_update(out cg_Pair destination, inout cg_Pair current)
{
    destination.values[0] = current.values[0] + (float) 1.0;
    destination.values[1] = current.values[1] + (float) 2.0;
    current.values[0] = current.values[0] * (float) 3.0;
    current.values[1] = current.values[1] * (float) 4.0;
}

cg_VertexOut cg_entry(float4 position)
{
    cg_VertexOut cg_output = (cg_VertexOut) 0;
    cg_Pair common;
    cg_Pair temp1;
    cg_Pair temp2;
    common.values[0] = position;
    common.values[1] = position + 1.0;
    temp2.values[0] = common.values[0];
    temp2.values[1] = common.values[1];
    cg_update(temp1, temp2);
    common.values[0] = temp1.values[0];
    common.values[1] = temp1.values[1];
    common.values[0] = temp2.values[0];
    common.values[1] = temp2.values[1];
    cg_output.position = common.values[0] + common.values[1];
    return cg_output;
}

cg_VertexOut_1 main(cg_VertexIn input)
{
    cg_VertexOut_1 output;
    cg_VertexOut cg_result;
    cg_result = cg_entry(input.position);
    output.position = cg_result.position;
    return output;
}
