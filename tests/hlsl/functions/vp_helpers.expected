// profile hlslv
// target vs_3_0
// cgc-bind interface in position float4 POSITION0
// cgc-bind interface out position float4 POSITION0

struct cg_VertexOut
{
    float4 position;
};

struct cg_VertexIn
{
    float4 position : POSITION0;
};

struct cg_VertexOut_1
{
    float4 position : POSITION0;
};

float2 cg_adjust(float2 value);

void cg_write_adjusted(float2 value, out float2 result)
{
    result = cg_adjust(value);
}

float2 cg_adjust(float2 value)
{
    return value * (float) 2.0;
}

float cg_adjust_1(float value)
{
    return value + (float) 1.0;
}

cg_VertexOut cg_entry(float4 position)
{
    cg_VertexOut cg_output = (cg_VertexOut) 0;
    float2 adjusted;
    cg_write_adjusted(position.xy, adjusted);
    cg_output.position = float4(cg_adjust_1(position.z), adjusted.x, adjusted.y, position.w);
    return cg_output;
}

cg_VertexOut_1 main(cg_VertexIn input)
{
    cg_VertexOut_1 output;
    cg_VertexOut cg_result;
    cg_result = cg_entry(input.position);
    output.position = cg_result.position;
    return output;
}
