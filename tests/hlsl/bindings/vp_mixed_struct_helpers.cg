struct Mixed {
    float scalar;
    int integer;
    bool enabled;
};

uniform Mixed mixed;

struct VertexOut {
    float4 position : POSITION;
};

float consume_first(float value)
{
    float result;
    result = value;
    result = result + (mixed.enabled ? mixed.scalar : (float) mixed.integer);
    return result;
}

float consume_second(float value)
{
    float result;
    result = value;
    result = result + mixed.scalar + (float) mixed.integer;
    return result;
}

float consume_none(float value)
{
    return value + 1.0;
}

VertexOut main(float4 position : POSITION)
{
    VertexOut output;
    output.position = position +
        float4(consume_first(position.x),
               consume_second(position.y),
               consume_none(position.z), 0.0);
    return output;
}
