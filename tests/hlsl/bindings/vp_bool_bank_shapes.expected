// profile hlslv
// target vs_3_0
// cgc-bind interface in position float4 POSITION0
// cgc-bind interface out position float4 POSITION0

// var bool3 flags : B0 : b[0] : 1 : 3
// cgc-default flags 1.0 0.0 1.0
// var cg_BoolConfig config : B7 : b[7] : 1 : 3
// var cg_NestedBool single : B10 : b[10] : 1 : 1
// cgc-default single 1.0
// var bool2 masks :  : b[3] : 1 : 4
// cgc-default masks 0.0 1.0 1.0 0.0

uniform bool cg_flags[3] : register(b0);
uniform bool cg_config[3] : register(b7);
uniform bool cg_single : register(b10);
uniform bool cg_masks[4] : register(b3);

struct cg_BoolConfig
{
    bool2 gates;
    bool enabled;
};

struct cg_OneBool
{
    bool enabled;
};

struct cg_NestedBool
{
    cg_OneBool inner;
};

struct cg_VertexOut
{
    float4 position;
};

struct cg_VertexIn
{
    float4 position : POSITION0;
};

struct cg_VertexOut_1
{
    float4 position : POSITION0;
};

cg_VertexOut cg_entry(float4 position)
{
    cg_VertexOut cg_output = (cg_VertexOut) 0;
    bool copiedEnabled;
    bool3 flags;
    bool2 masks[2];
    cg_BoolConfig config;
    cg_NestedBool single;
    float bank_select;
    float bank_select_1;
    cg_output.position = position;
    config.gates = bool2(cg_config[0], cg_config[1]);
    config.enabled = cg_config[2];
    copiedEnabled = config.enabled;
    flags = bool3(cg_flags[0], cg_flags[1], cg_flags[2]);
    if (flags.x)
    {
        cg_output.position.x = cg_output.position.x + 1.0;
    }
    if (flags.y)
    {
        cg_output.position.y = cg_output.position.y + 1.0;
    }
    if (flags.z)
    {
        cg_output.position.z = cg_output.position.z + 1.0;
    }
    masks[0] = bool2(cg_masks[0], cg_masks[1]);
    masks[1] = bool2(cg_masks[2], cg_masks[3]);
    if (masks[0].x)
    {
        cg_output.position.w = cg_output.position.w + 1.0;
    }
    if (masks[0].y)
    {
        cg_output.position.x = cg_output.position.x + 1.0;
    }
    if (masks[1].x)
    {
        cg_output.position.y = cg_output.position.y + 1.0;
    }
    if (masks[1].y)
    {
        cg_output.position.z = cg_output.position.z + 1.0;
    }
    if (config.gates.x)
    {
        if (config.enabled)
        {
            cg_output.position.w = cg_output.position.w + 1.0;
        }
    }
    single.inner.enabled = cg_single;
    if (single.inner.enabled)
    {
        cg_output.position.x = cg_output.position.x + 1.0;
    }
    if (flags.x)
    {
        if (config.enabled)
        {
            cg_output.position.y = cg_output.position.y + 0.25;
        }
    }
    if (flags.z)
    {
        bank_select = 0.5;
    }
    else
    {
        bank_select = 0.75;
    }
    cg_output.position.z = cg_output.position.z + (float) bank_select;
    if (flags.y)
    {
        if (single.inner.enabled)
        {
            cg_output.position.w = cg_output.position.w + 0.125;
        }
    }
    else
    {
        cg_output.position.w = cg_output.position.w + 0.125;
    }
    if (flags.x)
    {
        if (config.enabled)
        {
        }
        else
        {
            cg_output.position.x = cg_output.position.x + 0.03125;
        }
    }
    else
    {
        cg_output.position.x = cg_output.position.x + 0.03125;
    }
    if (copiedEnabled)
    {
        if (flags.x)
        {
            if (copiedEnabled)
            {
                bank_select_1 = 0.0625;
            }
            else
            {
                bank_select_1 = 0.0;
            }
            cg_output.position.y = cg_output.position.y + (float) bank_select_1;
        }
    }
    return cg_output;
}

cg_VertexOut_1 main(cg_VertexIn input)
{
    cg_VertexOut_1 output;
    cg_VertexOut cg_result;
    cg_result = cg_entry(input.position);
    output.position = cg_result.position;
    return output;
}
