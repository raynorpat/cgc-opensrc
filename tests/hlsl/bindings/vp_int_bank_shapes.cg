struct VertexOut {
    float4 position : POSITION;
};

VertexOut main(float4 position : POSITION,
               uniform int2 ranges[2])
{
    VertexOut output;
    int index;
    output.position = position;
    for (index = 0; index < ranges[1].y; index++)
        output.position.z += 0.001;
    return output;
}
