struct BoolConfig {
    bool2 gates;
    bool enabled;
};

struct OneBool {
    bool enabled;
};

struct NestedBool {
    OneBool inner;
};

uniform bool3 flags : B0 = bool3(true, false, true);
uniform bool2 masks[2] = {
    bool2(false, true),
    bool2(true, false)
};
uniform BoolConfig config : B7;

struct VertexOut {
    float4 position : POSITION;
};

VertexOut main(float4 position : POSITION,
               uniform NestedBool single : B10 = { { true } })
{
    VertexOut output;
    bool copiedEnabled;
    output.position = position;
    copiedEnabled = config.enabled;
    if (flags.x)
        output.position.x += 1.0;
    if (flags.y)
        output.position.y += 1.0;
    if (flags.z)
        output.position.z += 1.0;
    if (masks[0].x)
        output.position.w += 1.0;
    if (masks[0].y)
        output.position.x += 1.0;
    if (masks[1].x)
        output.position.y += 1.0;
    if (masks[1].y)
        output.position.z += 1.0;
    if (config.gates.x)
        if (config.enabled)
            output.position.w += 1.0;
    if (single.inner.enabled)
        output.position.x += 1.0;
    if (flags.x && config.enabled)
        output.position.y += 0.25;
    output.position.z += flags.z ? 0.5 : 0.75;
    if (!flags.y || single.inner.enabled)
        output.position.w += 0.125;
    if (!(flags.x && config.enabled))
        output.position.x += 0.03125;
    if (copiedEnabled && flags.x)
        output.position.y += copiedEnabled ? 0.0625 : 0.0;
    return output;
}
