#pragma bind main.scale = c 4
#pragma bind main.bias = default 2.0

struct VertexOut { float4 position : POSITION; };

VertexOut main(float4 position : ATTRIB0, uniform float scale,
               uniform float bias)
{
    VertexOut output;
    output.position = position * scale + float4(bias, 0.0, 0.0, 0.0);
    return output;
}
