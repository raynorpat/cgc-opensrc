// profile hlslv50
// target vs_5_0
// cgc-bind interface in position float4 POSITION0 POSITION0 user default
// cgc-bind interface out position float4 SV_Position SV_Position system default

// cgc-bind uniform scale half b0 c0.x byte=0 size=4 span=1 semantic=C0
// cgc-bind uniform axis float3 b0 c0.y byte=4 size=12 span=1 semantic=-
// cgc-default axis 3.0 4.0 5.0
// cgc-bind uniform bias float2 b0 c1.x byte=16 size=8 span=1 semantic=-
// cgc-default bias 6.0 7.0
// cgc-bind uniform transform float3x2 b0 c2.x byte=32 size=48 span=3 semantic=C2
// cgc-default transform 8.0 9.0 10.0 11.0 12.0 13.0
// cgc-bind uniform colors float4[2] b0 c5.x byte=80 size=32 span=2 semantic=-
// cgc-default colors 14.0 15.0 16.0 17.0 18.0 19.0 20.0 21.0
// cgc-bind uniform settings Settings b0 c7.x byte=112 size=32 span=2 semantic=-
// cgc-bind uniform table Settings[2][3] b0 c9.x byte=144 size=192 span=12 semantic=-
// cgc-bind uniform gain float b0 c1.z byte=24 size=4 span=1 semantic=-
// cgc-default gain 22.0

struct cg_InnerSettings
{
    float2 offset;
    int count;
    bool enabled;
};

struct cg_Settings
{
    cg_InnerSettings inner;
    float3 tint;
};

struct cg_VertexOut
{
    float4 position;
};

struct cg_VertexIn
{
    float4 position : POSITION0;
};

struct cg_VertexOut_1
{
    float4 position : SV_Position;
};

cbuffer cgc_Uniforms : register(b0)
{
    float cgc_scale : packoffset(c0.x);
    float3 cgc_axis : packoffset(c0.y);
    float2 cgc_bias : packoffset(c1.x);
    float cgc_gain : packoffset(c1.z);
    row_major float3x2 cgc_transform : packoffset(c2);
    float4 cgc_colors[2] : packoffset(c5);
    cg_Settings cgc_settings : packoffset(c7);
    cg_Settings cgc_table[2][3] : packoffset(c9);
};

cg_VertexOut cg_entry(float4 position, float gain)
{
    cg_VertexOut cg_output = (cg_VertexOut) 0;
    float3 transformed;
    transformed = mul(cgc_transform, position.xy);
    cg_output.position = position * ((float) cgc_scale * gain) + float4(cgc_axis.x + cgc_bias.x + transformed.x + cgc_colors[0].x + cgc_table[1][2].inner.offset.x, cgc_settings.inner.offset.y + transformed.y, cgc_settings.tint.z + (float) cgc_settings.inner.count, (float) (cgc_settings.inner.enabled ? 1.0 : 0.0));
    return cg_output;
}

cg_VertexOut_1 main(cg_VertexIn input)
{
    cg_VertexOut_1 output;
    cg_VertexOut cg_result;
    cg_result = cg_entry(input.position, cgc_gain);
    output.position = cg_result.position;
    return output;
}
