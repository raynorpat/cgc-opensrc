// profile hlslv50
// target vs_5_0
// cgc-bind interface in position float4 ATTRIB0 ATTRIB0 user default
// cgc-bind interface in normal float3 ATTRIB1 ATTRIB1 user default
// cgc-bind interface in color float4 ATTRIB2 ATTRIB2 user default
// cgc-bind interface out HPOS float4 SV_Position SV_Position system default
// cgc-bind interface out COL0 float4 COLOR0 COLOR0 user default
// cgc-bind interface out TEX0 float4 TEXCOORD0 TEXCOORD0 user default

// cgc-bind uniform object_matrix float3x3 b0 c0.x byte=0 size=48 span=3 semantic=-
// cgc-bind uniform objviewproj_matrix float4x4 b0 c3.x byte=48 size=64 span=4 semantic=-
// cgc-bind uniform lightdir float3[4] b0 c7.x byte=112 size=64 span=4 semantic=-
// cgc-bind uniform lightcolor float3[4] b0 c11.x byte=176 size=64 span=4 semantic=-
// cgc-bind uniform ambientcolor float3 b0 c15.x byte=240 size=12 span=1 semantic=-

cbuffer cgc_Uniforms : register(b0)
{
    row_major float3x3 cgc_object_matrix : packoffset(c0);
    row_major float4x4 cgc_objviewproj_matrix : packoffset(c3);
    float3 cgc_lightdir[4] : packoffset(c7);
    float3 cgc_lightcolor[4] : packoffset(c11);
    float3 cgc_ambientcolor : packoffset(c15.x);
};

struct cg_appdata
{
    float4 position;
    float3 normal;
    float4 color;
};

struct cg_vf20
{
    float4 HPOS;
    float4 COL0;
    float4 TEX0;
};

struct cg_VertexIn
{
    float4 position : ATTRIB0;
    float3 normal : ATTRIB1;
    float4 color : ATTRIB2;
};

struct cg_VertexOut
{
    float4 HPOS : SV_Position;
    float4 COL0 : COLOR0;
    float4 TEX0 : TEXCOORD0;
};

float3 cg_diffuse(float3 normal, float3 lightv, float3 color)
{
    return max(dot(normal, lightv), (float) 0) * color;
}

cg_vf20 cg_entry(cg_appdata I, row_major float3x3 object_matrix, row_major float4x4 objviewproj_matrix, float3 lightdir[4], float3 lightcolor[4], float3 ambientcolor)
{
    cg_vf20 O = (cg_vf20) 0;
    float3 norm;
    O.HPOS = mul(objviewproj_matrix, I.position);
    norm = mul(object_matrix, I.normal);
    O.COL0.xyz = I.color.xyz * cg_diffuse(norm, lightdir[0], lightcolor[0]) * cg_diffuse(norm, lightdir[1], lightcolor[1]) * cg_diffuse(norm, lightdir[2], lightcolor[2]) * cg_diffuse(norm, lightdir[3], lightcolor[3]) + ambientcolor;
    O.COL0.w = I.color.w;
    return O;
}

cg_VertexOut main(cg_VertexIn input)
{
    cg_appdata I;
    cg_VertexOut output;
    cg_vf20 cg_result;
    I.position = input.position;
    I.normal = input.normal;
    I.color = input.color;
    cg_result = cg_entry(I, cgc_object_matrix, cgc_objviewproj_matrix, cgc_lightdir, cgc_lightcolor, cgc_ambientcolor);
    output.HPOS = cg_result.HPOS;
    output.COL0 = cg_result.COL0;
    output.TEX0 = cg_result.TEX0;
    return output;
}
