// profile hlslv50
// target vs_5_0
// cgc-bind interface in position float4 POSITION0 POSITION0 user default
// cgc-bind interface out result float4 SV_Position SV_Position system default

struct cg_VertexIn
{
    float4 position : POSITION0;
};

struct cg_VertexOut
{
    float4 result : SV_Position;
};

int cg_exercise_bitwise(int value, int mask)
{
    value = (value | mask) ^ value & mask;
    value = value << (int) 1;
    value = value >> (int) 1;
    value = value | (int) 8;
    value = value ^ (int) 3;
    value = value & (int) 15;
    value = value << (int) 1;
    value = value >> (int) 1;
    return ~value;
}

float4 cg_entry(float4 position)
{
    int value;
    value = cg_exercise_bitwise((int) position.x, 5);
    return position + float4((float) value, 0.0, 0.0, 0.0);
}

cg_VertexOut main(cg_VertexIn input)
{
    cg_VertexOut output;
    output.result = cg_entry(input.position);
    return output;
}
