float4 main(float4 position : POSITION) : POSITION
{
    char c = 1;
    unsigned char uc = 2;
    short s = 3;
    unsigned short us = 4;
    int i = 5;
    unsigned int ui = 6;
    long l = 7;
    unsigned long ul = 8;
    half h = 0.5;
    fixed x = 0.5;
    float f = 0.5;
    double d = 0.5;
    float4 iv = float4(float(c), float(uc), float(s), float(us));
    float4 uv = float4(float(i), float(ui), float(l), float(ul));
    float scale = float(h) + float(x) + f + float(d);
    return position + (iv + uv) * scale * 0.0;
}
