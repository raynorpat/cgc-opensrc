// profile hlslv40
// target vs_4_0
// cgc-bind interface in position float4 POSITION0 POSITION0 user default
// cgc-bind interface in coord float4 TEXCOORD0 TEXCOORD0 user default
// cgc-bind interface out result float4 SV_Position SV_Position system default

// cgc-bind sampler lineImage sampler1D t0 s0
// cgc-bind sampler planeImage sampler2D t1 s1
// cgc-bind sampler volumeImage sampler3D t2 s2
// cgc-bind sampler cubeImage samplerCUBE t3 s3

struct cg_VertexIn
{
    float4 position : POSITION0;
    float4 coord : TEXCOORD0;
};

struct cg_VertexOut
{
    float4 result : SV_Position;
};

Texture1D<float4> cgc_texture_lineImage : register(t0);
SamplerState cgc_sampler_lineImage : register(s0);
Texture2D<float4> cgc_texture_planeImage : register(t1);
SamplerState cgc_sampler_planeImage : register(s1);
Texture3D<float4> cgc_texture_volumeImage : register(t2);
SamplerState cgc_sampler_volumeImage : register(s2);
TextureCube<float4> cgc_texture_cubeImage : register(t3);
SamplerState cgc_sampler_cubeImage : register(s3);

float4 cg_sample_plane_grad(Texture2D<float4> cgc_texture_image, SamplerState cgc_sampler_image, float2 uv, float2 dx, float2 dy)
{
    return cgc_texture_image.SampleGrad(cgc_sampler_image, uv, dx, dy);
}

float4 cg_entry(float4 position, float4 coord, Texture1D<float4> cgc_texture_lineImage, SamplerState cgc_sampler_lineImage, Texture2D<float4> cgc_texture_planeImage, SamplerState cgc_sampler_planeImage, Texture3D<float4> cgc_texture_volumeImage, SamplerState cgc_sampler_volumeImage, TextureCube<float4> cgc_texture_cubeImage, SamplerState cgc_sampler_cubeImage)
{
    float4 result;
    float4 temp1;
    float4 temp2;
    float4 temp3;
    float4 temp4;
    float4 temp5;
    float4 temp6;
    float4 temp7;
    temp1 = coord;
    result = cgc_texture_lineImage.SampleLevel(cgc_sampler_lineImage, temp1.x, temp1.w);
    temp3 = result;
    temp2 = coord;
    result = temp3 + cgc_texture_planeImage.SampleLevel(cgc_sampler_planeImage, temp2.xy, temp2.w);
    temp5 = result;
    temp4 = coord;
    result = temp5 + cgc_texture_volumeImage.SampleLevel(cgc_sampler_volumeImage, temp4.xyz, temp4.w);
    temp7 = result;
    temp6 = coord;
    result = temp7 + cgc_texture_cubeImage.SampleLevel(cgc_sampler_cubeImage, temp6.xyz, temp6.w);
    result = result + cgc_texture_lineImage.SampleGrad(cgc_sampler_lineImage, coord.x, coord.x, coord.x);
    result = result + cg_sample_plane_grad(cgc_texture_planeImage, cgc_sampler_planeImage, coord.xy, coord.xy, coord.xy);
    result = result + cgc_texture_volumeImage.SampleGrad(cgc_sampler_volumeImage, coord.xyz, coord.xyz, coord.xyz);
    result = result + cgc_texture_cubeImage.SampleGrad(cgc_sampler_cubeImage, coord.xyz, coord.xyz, coord.xyz);
    return position + result;
}

cg_VertexOut main(cg_VertexIn input)
{
    cg_VertexOut output;
    output.result = cg_entry(input.position, input.coord, cgc_texture_lineImage, cgc_sampler_lineImage, cgc_texture_planeImage, cgc_sampler_planeImage, cgc_texture_volumeImage, cgc_sampler_volumeImage, cgc_texture_cubeImage, cgc_sampler_cubeImage);
    return output;
}
