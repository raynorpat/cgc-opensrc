// profile hlslf
// target ps_3_0
struct cg_PixelIn
{
    float4 color : COLOR0;
};

struct cg_PixelOut
{
    float4 result : COLOR0;
};

float4 cg_entry(float4 color)
{
    if (color.w < 0.5)
    {
        discard;
    }
    return color;
}

cg_PixelOut main(cg_PixelIn input)
{
    cg_PixelOut output;
    output.result = cg_entry(input.color);
    return output;
}
