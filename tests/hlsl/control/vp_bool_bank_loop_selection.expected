// profile hlslv
// target vs_3_0
// cgc-bind interface in position float4 POSITION0
// cgc-bind interface out position float4 POSITION0

// var bool enabled :  : b[0] : 1 : 1

uniform bool cg_enabled : register(b0);

struct cg_VertexOut
{
    float4 position;
};

struct cg_VertexIn
{
    float4 position : POSITION0;
};

struct cg_VertexOut_1
{
    float4 position : POSITION0;
};

float cg_record(inout float trace, float digit)
{
    trace = trace * (float) 10.0 + digit;
    return trace;
}

cg_VertexOut cg_entry(float4 position)
{
    cg_VertexOut cg_output = (cg_VertexOut) 0;
    float trace;
    int index;
    int cg_temp;
    bool temp1;
    float temp2;
    float temp3;
    float temp4;
    float bank_select;
    cg_output.position = position;
    trace = 0.0;
    for (index = 0; index < 2; cg_temp = index, index = index + 1, cg_temp)
    {
        temp4 = cg_output.position.x;
        temp1 = cg_enabled;
        temp2 = cg_record(trace, 1.0);
        temp3 = cg_record(trace, 2.0);
        if (temp1)
        {
            bank_select = temp2;
        }
        else
        {
            bank_select = temp3;
        }
        cg_output.position.x = temp4 + bank_select;
    }
    cg_output.position.y = trace;
    return cg_output;
}

cg_VertexOut_1 main(cg_VertexIn input)
{
    cg_VertexOut_1 output;
    cg_VertexOut cg_result;
    cg_result = cg_entry(input.position);
    output.position = cg_result.position;
    return output;
}
