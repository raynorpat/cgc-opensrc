// profile hlslv
// target vs_3_0
struct cg_VertexOut
{
    float4 position;
};

struct cg_VertexIn
{
    float4 position : POSITION0;
};

struct cg_VertexOut_1
{
    float4 position : POSITION0;
};

bool cg_trace_condition(inout float trace, float digit, bool result)
{
    trace = trace * (float) 10.0 + digit;
    return result;
}

int cg_trace_step(inout float trace, float digit, int value)
{
    trace = trace * (float) 10.0 + digit;
    return value + (int) 1;
}

cg_VertexOut cg_entry(float4 position)
{
    cg_VertexOut cg_output;
    bool choose;
    float trace;
    int index;
    bool temp1;
    bool temp2;
    bool temp3;
    bool temp4;
    bool temp5;
    bool temp6;
    bool temp7;
    bool temp8;
    bool temp9;
    bool temp10;
    bool temp11;
    int temp12;
    int temp13;
    choose = position.x > 0.0;
    trace = 0.0;
    index = 0;
    while (true)
    {
        temp1 = choose;
        temp2 = cg_trace_condition(trace, 1.0, index < 2);
        temp3 = cg_trace_condition(trace, 2.0, index < 2);
        if (!(temp1 ? temp2 : temp3))
        {
            break;
        }
        {
            index = index + 1;
            if (index == 1)
            {
                continue;
            }
            trace = trace + 0.25;
        }
    }
    index = 0;
    temp7 = true;
    while (true)
    {
        if (!temp7)
        {
            temp4 = choose;
            temp5 = cg_trace_condition(trace, 3.0, index < 2);
            temp6 = cg_trace_condition(trace, 4.0, index < 2);
            if (!(temp4 ? temp5 : temp6))
            {
                break;
            }
        }
        temp7 = false;
        {
            index = index + 1;
            if (index == 1)
            {
                continue;
            }
            trace = trace + 0.5;
        }
    }
    for (index = 0; ; temp11 = choose, temp12 = cg_trace_step(trace, 7.0, index), temp13 = cg_trace_step(trace, 8.0, index), index = temp11 ? temp12 : temp13)
    {
        temp8 = choose;
        temp9 = cg_trace_condition(trace, 5.0, index < 2);
        temp10 = cg_trace_condition(trace, 6.0, index < 2);
        if (!(temp8 ? temp9 : temp10))
        {
            break;
        }
        {
            if (index == 0)
            {
                continue;
            }
            if (index == 1)
            {
                break;
            }
            trace = trace + 0.75;
        }
    }
    cg_output.position = float4(position.x, position.y, position.z, trace);
    return cg_output;
}

cg_VertexOut_1 main(cg_VertexIn input)
{
    cg_VertexOut_1 output;
    cg_VertexOut cg_result;
    cg_result = cg_entry(input.position);
    output.position = cg_result.position;
    return output;
}
