// profile hlslf
// target ps_3_0
struct cg_FragmentOut
{
    float4 color;
};

struct cg_PixelIn
{
    float4 value : TEXCOORD0;
};

struct cg_PixelOut
{
    float4 color : COLOR0;
};

float4 cg_shade(float4 value)
{
    bool scalar;
    bool2 pair;
    bool3 triple;
    bool4 quad;
    float2 temp1;
    float2 temp2;
    float3 temp3;
    float3 temp4;
    float4 temp5;
    float4 temp6;
    bool2 temp7;
    bool3 temp8;
    bool4 temp9;
    scalar = value.x < (float) 0.0;
    temp1 = value.xy;
    temp2 = (float2) float2(0.0, 0.0);
    pair = bool2(temp1.x < temp2.x, temp1.y < temp2.y);
    temp3 = value.xyz;
    temp4 = (float3) float3(0.0, 0.0, 0.0);
    triple = bool3(temp3.x < temp4.x, temp3.y < temp4.y, temp3.z < temp4.z);
    temp5 = value;
    temp6 = (float4) float4(0.0, 0.0, 0.0, 0.0);
    quad = bool4(temp5.x < temp6.x, temp5.y < temp6.y, temp5.z < temp6.z, temp5.w < temp6.w);
    if (scalar)
    {
        discard;
    }
    temp7 = pair;
    if (temp7.x || temp7.y)
    {
        discard;
    }
    temp8 = triple;
    if (temp8.x || temp8.y || temp8.z)
    {
        discard;
    }
    temp9 = quad;
    if (temp9.x || temp9.y || temp9.z || temp9.w)
    {
        discard;
    }
    return value;
}

cg_FragmentOut cg_entry(float4 value)
{
    cg_FragmentOut cg_output;
    cg_output.color = cg_shade(value);
    return cg_output;
}

cg_PixelOut main(cg_PixelIn input)
{
    cg_PixelOut output;
    cg_FragmentOut cg_result;
    cg_result = cg_entry(input.value);
    output.color = cg_result.color;
    return output;
}
