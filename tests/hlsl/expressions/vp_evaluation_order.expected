// profile hlslv
// target vs_3_0
struct cg_VertexOut
{
    float4 position;
};

struct cg_VertexIn
{
    float4 position : POSITION0;
};

struct cg_VertexOut_1
{
    float4 position : POSITION0;
};

float cg_nestedModify(inout float value, float amount);

float cg_bumpValue(inout float value);

float cg_record(inout float trace, float digit)
{
    trace = trace * (float) 10.0 + digit;
    return trace;
}

float cg_combine(float left, float right)
{
    return left + right;
}

float2 cg_record2(inout float trace, float digit)
{
    trace = trace * (float) 10.0 + digit;
    return float2(trace, trace + (float) 1.0);
}

float cg_modify(inout float value, float amount)
{
    value = value + amount;
    return value;
}

float cg_replace(out float value, float amount)
{
    value = amount + (float) 1.0;
    return value;
}

float cg_forwardWrapper(inout float value, inout float trace)
{
    return cg_nestedModify(value, cg_bumpValue(trace));
}

float cg_nestedModify(inout float value, float amount)
{
    value = value + amount;
    return value;
}

float cg_bumpValue(inout float value)
{
    value = value + (float) 1.0;
    return value;
}

float cg_moveIndex(inout int index, int next)
{
    index = next;
    return (float) index;
}

cg_VertexOut cg_entry(float4 position)
{
    cg_VertexOut cg_output;
    bool choose;
    bool2 lanes;
    bool2 comparison;
    float trace;
    float binary;
    float called;
    float readBinary;
    float readCall;
    float aliasValue;
    float aliasResult;
    float outValue;
    float outResult;
    float nestedValue;
    float nestedTrace;
    float nestedResult;
    float effectTrace;
    float effectRead;
    float constructorTrace;
    float2 constructed;
    float4 indexedValues;
    int indexedPosition;
    float indexedResult;
    float2 temp1;
    float2 temp2;
    float temp3;
    float temp4;
    float temp5;
    float temp6;
    float2 temp7;
    bool2 temp8;
    float2 temp9;
    float2 temp10;
    float2 temp11;
    float temp12;
    float temp13;
    float temp14;
    float temp15;
    float temp16;
    float temp17;
    float temp18;
    float temp19;
    float temp20;
    int temp21;
    float temp22;
    int temp23;
    choose = position.x > 0.0;
    temp1 = position.xy;
    temp2 = float2(0.0, 0.0);
    lanes = bool2(temp1.x > temp2.x, temp1.y > temp2.y);
    trace = 0.0;
    temp4 = cg_record(trace, 1.0);
    if (choose)
    {
        temp3 = cg_record(trace, 2.0);
    }
    else
    {
        temp3 = cg_record(trace, 3.0);
    }
    binary = temp4 + temp3;
    temp6 = cg_record(trace, 4.0);
    if (choose)
    {
        temp5 = cg_record(trace, 5.0);
    }
    else
    {
        temp5 = cg_record(trace, 6.0);
    }
    called = cg_combine(temp6, temp5);
    temp7 = cg_record2(trace, 7.0);
    temp8 = lanes;
    temp9 = cg_record2(trace, 8.0);
    temp10 = cg_record2(trace, 9.0);
    temp11 = float2(temp8.x ? temp9.x : temp10.x, temp8.y ? temp9.y : temp10.y);
    comparison = bool2(temp7.x < temp11.x, temp7.y < temp11.y);
    temp13 = trace;
    if (choose)
    {
        temp12 = cg_record(trace, 10.0);
    }
    else
    {
        temp12 = cg_record(trace, 11.0);
    }
    readBinary = temp13 + temp12;
    temp15 = trace;
    if (choose)
    {
        temp14 = cg_record(trace, 12.0);
    }
    else
    {
        temp14 = cg_record(trace, 13.0);
    }
    readCall = cg_combine(temp15, temp14);
    aliasValue = 1.0;
    if (choose)
    {
        temp16 = cg_record(aliasValue, 17.0);
    }
    else
    {
        temp16 = cg_record(aliasValue, 18.0);
    }
    aliasResult = cg_modify(aliasValue, temp16);
    outValue = 2.0;
    if (choose)
    {
        temp17 = cg_record(outValue, 19.0);
    }
    else
    {
        temp17 = cg_record(outValue, 20.0);
    }
    outResult = cg_replace(outValue, temp17);
    nestedValue = 3.0;
    nestedTrace = 4.0;
    nestedResult = cg_forwardWrapper(nestedValue, nestedTrace);
    effectTrace = 5.0;
    temp18 = cg_record(effectTrace, 21.0);
    effectRead = cg_combine(temp18, effectTrace);
    constructorTrace = 6.0;
    temp19 = cg_record(constructorTrace, 22.0);
    constructed = float2(temp19, constructorTrace);
    indexedValues = float4(1.0, 2.0, 3.0, 4.0);
    indexedPosition = 0;
    temp21 = indexedPosition;
    if (choose)
    {
        temp20 = cg_moveIndex(indexedPosition, 1);
    }
    else
    {
        temp20 = cg_moveIndex(indexedPosition, 2);
    }
    indexedResult = cg_modify(indexedValues[temp21], temp20);
    indexedPosition = 0;
    temp23 = indexedPosition;
    if (choose)
    {
        temp22 = cg_moveIndex(indexedPosition, 2);
    }
    else
    {
        temp22 = cg_moveIndex(indexedPosition, 3);
    }
    indexedValues[temp23] = temp22;
    cg_output.position = float4(binary + readBinary + effectRead, called + readCall + constructed.x + constructed.y, (float) comparison.x + aliasValue + nestedValue + indexedValues.x + indexedValues.y, trace + aliasResult + outValue + outResult + nestedTrace + nestedResult + indexedResult + indexedValues.z + indexedValues.w);
    return cg_output;
}

cg_VertexOut_1 main(cg_VertexIn input)
{
    cg_VertexOut_1 output;
    cg_VertexOut cg_result;
    cg_result = cg_entry(input.position);
    output.position = cg_result.position;
    return output;
}
