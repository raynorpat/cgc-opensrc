// profile hlslv
// target vs_3_0
// cgc-bind interface in position float4 POSITION0
// cgc-bind interface out position float4 POSITION0

struct cg_VertexOut
{
    float4 position;
};

struct cg_VertexIn
{
    float4 position : POSITION0;
};

struct cg_VertexOut_1
{
    float4 position : POSITION0;
};

float cg_bump(inout float value)
{
    value = value + (float) 1.0;
    return value;
}

float2 cg_bump2(inout float2 value, float amount)
{
    value = value + amount;
    return value;
}

cg_VertexOut cg_entry(float4 position)
{
    cg_VertexOut cg_output = (cg_VertexOut) 0;
    float counter;
    float commaResult;
    float scalarResult;
    bool2 condition;
    float2 selected;
    float2 trueValue;
    float2 falseValue;
    float cg_temp;
    float cg_temp_1;
    bool temp1;
    float temp2;
    float temp3;
    float2 temp4;
    float2 temp5;
    bool2 temp6;
    float2 temp7;
    float2 temp8;
    counter = 0.0;
    cg_temp = counter;
    counter = counter + 1.0;
    cg_temp;
    commaResult = counter;
    cg_temp_1 = counter;
    counter = counter + 1.0;
    cg_temp_1;
    commaResult = commaResult + counter;
    temp1 = position.x > 0.0;
    temp2 = cg_bump(counter);
    temp3 = cg_bump(counter);
    scalarResult = temp1 ? temp2 : temp3;
    temp4 = position.xy;
    temp5 = float2(0.0, 0.0);
    condition = bool2(temp4.x > temp5.x, temp4.y > temp5.y);
    trueValue = float2(1.0, 2.0);
    falseValue = float2(3.0, 4.0);
    temp6 = condition;
    temp7 = cg_bump2(trueValue, 10.0);
    temp8 = cg_bump2(falseValue, 20.0);
    selected = float2(temp6.x ? temp7.x : temp8.x, temp6.y ? temp7.y : temp8.y);
    cg_output.position = float4(selected.x, selected.y, scalarResult, commaResult);
    return cg_output;
}

cg_VertexOut_1 main(cg_VertexIn input)
{
    cg_VertexOut_1 output;
    cg_VertexOut cg_result;
    cg_result = cg_entry(input.position);
    output.position = cg_result.position;
    return output;
}
