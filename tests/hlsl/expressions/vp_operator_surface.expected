// profile hlslv
// target vs_3_0
// cgc-bind interface in position float4 TEXCOORD0
// cgc-bind interface out position float4 POSITION0

struct cg_VertexOut
{
    float4 position;
};

struct cg_VertexIn
{
    float4 position : TEXCOORD0;
};

struct cg_VertexOut_1
{
    float4 position : POSITION0;
};

cg_VertexOut cg_entry(float4 position)
{
    cg_VertexOut cg_output = (cg_VertexOut) 0;
    int bits;
    int foldedBits;
    float value;
    int cg_temp;
    int cg_temp_1;
    foldedBits = 12;
    bits = (int) position.x;
    bits = bits + 1;
    cg_temp = bits;
    bits = bits - 1;
    cg_temp;
    bits = bits - 1;
    cg_temp_1 = bits;
    bits = bits + 1;
    cg_temp_1;
    bits = bits % 7;
    value = position.y;
    value = value + 2.0;
    value = value - 1.0;
    value = value * 3.0;
    value = value / 2.0;
    cg_output.position = float4((float) bits, value, position.z, position.w + (float) foldedBits * 0.0);
    return cg_output;
}

cg_VertexOut_1 main(cg_VertexIn input)
{
    cg_VertexOut_1 output;
    cg_VertexOut cg_result;
    cg_result = cg_entry(input.position);
    output.position = cg_result.position;
    return output;
}
