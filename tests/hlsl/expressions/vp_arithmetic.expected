// profile hlslv
// target vs_3_0
// cgc-bind interface in position float4 POSITION0
// cgc-bind interface in texcoord float4 TEXCOORD0
// cgc-bind interface out position float4 POSITION0
// cgc-bind interface out color float4 COLOR0

struct cg_VertexOut
{
    float4 position;
    float4 color;
};

struct cg_VertexIn
{
    float4 position : POSITION0;
    float4 texcoord : TEXCOORD0;
};

struct cg_VertexOut_1
{
    float4 position : POSITION0;
    float4 color : COLOR0;
};

cg_VertexOut cg_entry(float4 position, float4 texcoord)
{
    cg_VertexOut cg_output = (cg_VertexOut) 0;
    float2 first;
    float2 second;
    bool2 vectorLess;
    bool scalarLogic;
    bool scalarEqual;
    int element;
    float arithmetic;
    float2 temp1;
    float2 temp2;
    first = float2(+position.x, -position.y);
    second = texcoord.xy + float2(2.0, 3.0);
    arithmetic = (first.x + second.x - first.y * second.y) / (second.x + 1.0);
    element = ((int) position.x + 5) % 2;
    scalarEqual = arithmetic == 0.0 || arithmetic != 1.0;
    scalarLogic = arithmetic < 4.0 && arithmetic > -4.0 && arithmetic <= 3.0 && arithmetic >= -3.0 && !scalarEqual;
    temp1 = first;
    temp2 = second;
    vectorLess = bool2(temp1.x < temp2.x, temp1.y < temp2.y);
    cg_output.position = float4(first[element], arithmetic, (float) element, position.w);
    cg_output.color = float4((float) vectorLess.x, (float) vectorLess.y, (float) scalarLogic, (float) (int) texcoord.z);
    return cg_output;
}

cg_VertexOut_1 main(cg_VertexIn input)
{
    cg_VertexOut_1 output;
    cg_VertexOut cg_result;
    cg_result = cg_entry(input.position, input.texcoord);
    output.position = cg_result.position;
    output.color = cg_result.color;
    return output;
}
