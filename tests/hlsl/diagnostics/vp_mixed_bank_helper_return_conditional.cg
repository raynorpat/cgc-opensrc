struct Mixed {
    float scalar;
    int count;
    bool enabled;
};

uniform Mixed first;
uniform Mixed second;
uniform float choose;

Mixed load_mixed(int unused)
{
    return choose > 0.0 ? first : second;
}

struct VertexOut { float4 position : POSITION; };

VertexOut main(float4 position : POSITION)
{
    VertexOut output;
    Mixed value;
    int index;
    value = load_mixed(0);
    output.position = position;
    for (index = 0; index < value.count; index++)
        output.position.x += value.enabled ? value.scalar : 0.0;
    return output;
}
