    int2 shortVector2;
    int3 shortVector3;
    int4 shortVector;
    int ushortValue;
    int ushortCanonical;
    int ushortVector1;
    int2 ushortVector2;
    int3 ushortVector3;
    int4 ushortVector;
    int uintValue;
    int explicitUintValue;
    int uintCanonical;
    int uintVector1;
    int2 uintVector2;
    int3 uintVector3;
    int4 uintVector;
    int longValue;
