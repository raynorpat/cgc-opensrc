    row_major float4x1 matrix41;
    row_major float4x2 matrix42;
    row_major float4x3 matrix43;
    row_major float4x4 matrix44;
    float lengthVector[5];
    int aggregateLength;
    float finished;
    one = 1.0;
    index = 2;
    byteValue = 7;
    ubyteValue = 8;
    shortValue = 9;
    ushortValue = 10;
    uintValue = 11;
    longValue = 12;
    ulongValue = 13;
    offset = 0.0;
    fixedValue = 0.25 + (float) cg_input.x;
    halfValue = 0.5 + (float) cg_input.y;
    doubleValue = 0.75 + (float) cg_input.z;
    aggregateLength = 11;
    finished = 1.0 * cg_input.w;
    cg_finish(finished);
    cg_output.position = float4(cg_choose((float) fixedValue, 3.0), cg_choose((float) halfValue, (float) index), (float) doubleValue * (float) one + offset, finished + (float) aggregateLength * 0.0);
    return cg_output;
}

cg_VertexOut_1 main(cg_VertexIn input)
{
    cg_VertexOut_1 output;
    cg_VertexOut cg_result;
    cg_result = cg_entry(input.cg_cg_input);
    output.position = cg_result.position;
    return output;
}
