    int4 ulongVector;
    float offset;
    float fixedValue;
    float fixedVector1;
    float2 fixedVector2;
    float3 fixedVector3;
    float4 fixedVector;
    float halfValue;
    float halfVector1;
    float2 halfVector2;
    float3 halfVector3;
    float4 halfVector4;
    float doubleValue;
    float doubleVector1;
    float2 doubleVector2;
    float3 doubleVector3;
    float4 doubleVector;
    row_major float1x1 matrix11;
    row_major float1x2 matrix12;
    row_major float1x3 matrix13;
    row_major float1x4 matrix14;
    row_major float2x1 matrix21;
    row_major float2x2 matrix22;
    row_major float2x3 matrix23;
    row_major float2x4 matrix24;
    row_major float3x1 matrix31;
