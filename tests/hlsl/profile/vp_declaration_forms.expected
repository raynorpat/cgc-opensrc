    float compileFloat1;
    float2 compileFloat2;
    float3 compileFloat3;
    float4 compileFloatVector;
    int index;
    int compileInt1;
    int2 compileInt2;
    int3 compileInt3;
    int4 compileIntVector;
    int byteValue;
    int byteVector1;
    int2 byteVector2;
    int3 byteVector3;
