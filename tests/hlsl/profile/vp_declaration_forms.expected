// profile hlslv
// target vs_3_0
// cgc-bind interface in input float4 TEXCOORD0
// cgc-bind interface out position float4 POSITION0

struct cg_VertexOut
{
    float4 position;
};

struct cg_VertexIn
{
    float4 cg_cg_input : TEXCOORD0;
};

struct cg_VertexOut_1
{
    float4 position : POSITION0;
};

void cg_finish(inout float value)
{
    value = value + (float) 0.0;
    return;
}

float cg_choose(float value, float scale)
{
    return value * scale;
}

cg_VertexOut cg_entry(float4 cg_input)
{
    cg_VertexOut cg_output = (cg_VertexOut) 0;
    float floatVector1;
