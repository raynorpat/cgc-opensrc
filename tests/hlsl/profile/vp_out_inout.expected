// profile hlslv
// target vs_3_0
struct cg_VertexOut
{
    float4 position;
};

struct cg_VertexIn
{
    float4 position : POSITION0;
    float4 texcoord : TEXCOORD0;
};

struct cg_VertexOut_1
{
    float4 position : POSITION0;
    float4 color : COLOR0;
    float4 texcoord : TEXCOORD0;
};

cg_VertexOut cg_entry(float4 position, out float4 color, inout float4 texcoord)
{
    cg_VertexOut cg_output;
    cg_output.position = position;
    color = position;
    texcoord = texcoord * 2.0;
    return cg_output;
}

cg_VertexOut_1 main(cg_VertexIn input)
{
    float4 color;
    float4 texcoord;
    cg_VertexOut_1 output;
    cg_VertexOut cg_result;
    texcoord = input.texcoord;
    cg_result = cg_entry(input.position, color, texcoord);
    output.position = cg_result.position;
    output.color = color;
    output.texcoord = texcoord;
    return output;
}
