// profile hlslv
// target vs_3_0
struct cg_VertexOut
{
    float4 position;
};

struct cg_VertexIn
{
    float4 position : POSITION0;
};

struct cg_VertexOut_1
{
    float4 position : POSITION0;
};

float4 cg_adjust(float4 value, out float scale, inout float bias)
{
    scale = bias;
    bias = scale;
    return value * bias;
}

cg_VertexOut cg_entry(float4 position)
{
    float scale;
    float bias;
    cg_VertexOut cg_output;
    cg_output.position = cg_adjust(position, scale, bias);
    return cg_output;
}

cg_VertexOut_1 main(cg_VertexIn input)
{
    cg_VertexOut_1 output;
    cg_VertexOut cg_result;
    cg_result = cg_entry(input.position);
    output.position = cg_result.position;
    return output;
}
