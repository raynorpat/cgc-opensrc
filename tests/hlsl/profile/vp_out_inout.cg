struct VertexOut { float4 position : POSITION; };
VertexOut main(float4 position : POSITION,
               out float4 color : COLOR0,
               inout float4 texcoord : TEXCOORD0)
{
    VertexOut output;
    output.position = position;
    color = position;
    texcoord = texcoord * 2.0;
    return output;
}
