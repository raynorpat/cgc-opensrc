// profile hlslv
// target vs_3_0
// cgc-bind interface in position float4 POSITION0
// cgc-bind interface out position float4 POSITION0

// var float scale :  : c[0] : 1 : 1

float cg_scale : register(c0);

struct cg_VertexOut
{
    float4 position;
};

struct cg_VertexIn
{
    float4 position : POSITION0;
};

struct cg_VertexOut_1
{
    float4 position : POSITION0;
};

cg_VertexOut cg_entry(float4 position, float scale)
{
    cg_VertexOut cg_output = (cg_VertexOut) 0;
    cg_output.position = position * scale;
    return cg_output;
}

cg_VertexOut_1 main(cg_VertexIn input)
{
    cg_VertexOut_1 output;
    cg_VertexOut cg_result;
    cg_result = cg_entry(input.position, cg_scale);
    output.position = cg_result.position;
    return output;
}
