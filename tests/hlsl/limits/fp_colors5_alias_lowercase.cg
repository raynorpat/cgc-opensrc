struct PixelOut {
    float4 color0 : col0;
    float4 color1 : CoL1;
    float4 color2 : COL2;
    float4 color3 : cOl3;
    float4 color4 : color4;
};

PixelOut main(float4 color : COLOR0)
{
    PixelOut output;
    output.color0 = color;
    output.color1 = color;
    output.color2 = color;
    output.color3 = color;
    output.color4 = color;
    return output;
}
