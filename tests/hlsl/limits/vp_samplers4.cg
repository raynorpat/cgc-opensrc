float4 main(float4 position : POSITION,
            uniform sampler2D image0,
            uniform sampler2D image1,
            uniform sampler2D image2,
            uniform sampler2D image3) : POSITION
{
    return position + tex2Dlod(image0, position) +
           tex2Dlod(image1, position) + tex2Dlod(image2, position) +
           tex2Dlod(image3, position);
}
