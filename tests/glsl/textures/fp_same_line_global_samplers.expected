#version 150
// cgc-bind input cg_TEXCOORD0 TEXCOORD0
// cgc-bind output cg_COLOR0 COLOR0
// cgc-bind sampler z 0
// cgc-bind sampler a 1

struct FragmentOut
{
    vec4 color;
};

in vec2 cg_TEXCOORD0;
out vec4 cg_COLOR0;
uniform sampler2D z;
uniform sampler2D a;

vec4 sampleBoth(vec2 coord)
{
    return texture(a, coord) + texture(z, coord);
}

void main()
{
    vec2 coord;
    FragmentOut result;
    coord = cg_TEXCOORD0;
    result.color = sampleBoth(coord);
    cg_COLOR0 = result.color;
}
