#version 150
// cgc-bind input cg_TEXCOORD0 TEXCOORD0
// cgc-bind output cg_COLOR0 COLOR0

struct FragmentOut
{
    vec4 color;
};

in vec4 cg_TEXCOORD0;
out vec4 cg_COLOR0;

vec4 tex2D(vec4 value)
{
    return value * 0.5;
}

void main()
{
    vec4 color;
    FragmentOut result;
    color = cg_TEXCOORD0;
    result.color = tex2D(color);
    cg_COLOR0 = result.color;
}
