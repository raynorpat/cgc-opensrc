#version 110
// cgc-bind varying cg_TEXCOORD0 TEXCOORD0
// cgc-bind builtin gl_FragColor COLOR0

struct FragmentOut
{
    vec4 color;
};

varying vec4 cg_TEXCOORD0;

vec4 tex2D(vec4 value)
{
    return value * 0.5;
}

void main()
{
    vec4 color;
    FragmentOut result;
    color = cg_TEXCOORD0;
    result.color = tex2D(color);
    gl_FragColor = result.color;
}
