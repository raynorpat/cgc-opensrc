#version 150
// cgc-bind input cg_TEXCOORD0 TEXCOORD0
// cgc-bind output cg_COLOR0 COLOR0
// cgc-bind sampler cg_output 0
// cgc-bind sampler cg_output_1 1

struct FragmentOut
{
    vec4 color;
};

in vec2 cg_TEXCOORD0;
out vec4 cg_COLOR0;
uniform sampler2D cg_output;
uniform samplerCube cg_output_1;

void main()
{
    vec2 texcoord;
    FragmentOut result;
    vec3 direction;
    texcoord = cg_TEXCOORD0;
    direction = vec3(texcoord.x, texcoord.y, 1.0);
    result.color = texture(cg_output, texcoord) + texture(cg_output_1, direction);
    cg_COLOR0 = result.color;
}
