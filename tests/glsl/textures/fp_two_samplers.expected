#version 110
// cgc-bind varying cg_TEXCOORD0 TEXCOORD0
// cgc-bind sampler cg_output 0
// cgc-bind sampler cg_output_1 1
// cgc-bind builtin gl_FragColor COLOR0

struct FragmentOut
{
    vec4 color;
};

varying vec2 cg_TEXCOORD0;
uniform sampler2D cg_output;
uniform samplerCube cg_output_1;

void main()
{
    vec2 texcoord;
    FragmentOut result;
    vec3 direction;
    texcoord = cg_TEXCOORD0;
    direction = vec3(texcoord.x, texcoord.y, 1.0);
    result.color = texture2D(cg_output, texcoord) + textureCube(cg_output_1, direction);
    gl_FragColor = result.color;
}
