#version 150
// cgc-bind input cg_TEXCOORD0 TEXCOORD0
// cgc-bind output cg_COLOR0 COLOR0
// cgc-bind sampler environment 0

struct FragmentOut
{
    vec4 color;
};

in vec3 cg_TEXCOORD0;
out vec4 cg_COLOR0;
uniform samplerCube environment;

void main()
{
    vec3 direction;
    FragmentOut cg_output;
    direction = cg_TEXCOORD0;
    cg_output.color = texture(environment, direction);
    cg_COLOR0 = cg_output.color;
}
