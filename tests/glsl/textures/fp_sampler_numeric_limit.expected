#version 110
// cgc-bind varying cg_TEXCOORD0 TEXCOORD0
// cgc-bind uniform weights
// cgc-bind sampler image 0
// cgc-bind builtin gl_FragColor COLOR0

struct FragmentOut
{
    vec4 color;
};

varying vec2 cg_TEXCOORD0;
uniform vec4 weights[16];
uniform sampler2D image;

void main()
{
    vec2 coord;
    FragmentOut result;
    coord = cg_TEXCOORD0;
    result.color = texture2D(image, coord + weights[0].xy);
    gl_FragColor = result.color;
}
