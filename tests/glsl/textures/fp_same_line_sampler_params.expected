#version 110
// cgc-bind varying cg_TEXCOORD0 TEXCOORD0
// cgc-bind sampler z 0
// cgc-bind sampler a 1
// cgc-bind builtin gl_FragColor COLOR0

struct FragmentOut
{
    vec4 color;
};

varying vec2 cg_TEXCOORD0;
uniform sampler2D z;
uniform sampler2D a;

void main()
{
    vec2 coord;
    FragmentOut result;
    coord = cg_TEXCOORD0;
    result.color = texture2D(a, coord) + texture2D(z, coord);
    gl_FragColor = result.color;
}
