#version 110
// cgc-bind varying cg_TEXCOORD0 TEXCOORD0
// cgc-bind sampler image 0
// cgc-bind builtin gl_FragColor COLOR0

struct FragmentOut
{
    vec4 color;
};

varying float cg_TEXCOORD0;
uniform sampler1D image;

void main()
{
    float coord;
    FragmentOut cg_output;
    coord = cg_TEXCOORD0;
    cg_output.color = texture1D(image, coord);
    gl_FragColor = cg_output.color;
}
