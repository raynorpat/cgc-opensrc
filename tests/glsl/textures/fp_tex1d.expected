#version 150
// cgc-bind input cg_TEXCOORD0 TEXCOORD0
// cgc-bind output cg_COLOR0 COLOR0
// cgc-bind sampler image 0

struct FragmentOut
{
    vec4 color;
};

in float cg_TEXCOORD0;
out vec4 cg_COLOR0;
uniform sampler1D image;

void main()
{
    float coord;
    FragmentOut cg_output;
    coord = cg_TEXCOORD0;
    cg_output.color = texture(image, coord);
    cg_COLOR0 = cg_output.color;
}
