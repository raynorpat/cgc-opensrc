struct FragmentOut { float4 color : COLOR0; };
FragmentOut main(float2 coord : TEXCOORD0,
                 uniform sampler2D first,
                 uniform sampler2D second,
                 uniform sampler2D third)
{
    FragmentOut result;
    result.color = float4(coord.x, coord.y, 0.0, 1.0);
    return result;
}
