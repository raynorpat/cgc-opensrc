#version 150
// cgc-bind input cg_TEXCOORD0 TEXCOORD0
// cgc-bind output cg_COLOR0 COLOR0
// cgc-bind sampler image 0

struct FragmentOut
{
    vec4 color;
};

in vec2 cg_TEXCOORD0;
out vec4 cg_COLOR0;
uniform sampler2D image;

vec4 sampleImage(vec2 coord)
{
    return texture(image, coord) + texture(image, coord);
}

void main()
{
    vec2 coord;
    FragmentOut result;
    coord = cg_TEXCOORD0;
    result.color = sampleImage(coord);
    cg_COLOR0 = result.color;
}
