#version 110
// cgc-bind varying cg_TEXCOORD0 TEXCOORD0
// cgc-bind sampler image 0
// cgc-bind builtin gl_FragColor COLOR0

struct FragmentOut
{
    vec4 color;
};

varying vec2 cg_TEXCOORD0;
uniform sampler2D image;

vec4 sampleImage(vec2 coord)
{
    return texture2D(image, coord) + texture2D(image, coord);
}

void main()
{
    vec2 coord;
    FragmentOut result;
    coord = cg_TEXCOORD0;
    result.color = sampleImage(coord);
    gl_FragColor = result.color;
}
