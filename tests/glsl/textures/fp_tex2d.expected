#version 150
// cgc-bind input cg_TEXCOORD0 TEXCOORD0
// cgc-bind output cg_COLOR0 COLOR0
// cgc-bind sampler image 0

struct FragmentOut
{
    vec4 color;
};

in vec2 cg_TEXCOORD0;
out vec4 cg_COLOR0;
uniform sampler2D image;

void main()
{
    vec2 texcoord;
    FragmentOut cg_output;
    texcoord = cg_TEXCOORD0;
    cg_output.color = texture(image, texcoord);
    cg_COLOR0 = cg_output.color;
}
