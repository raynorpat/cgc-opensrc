#version 110
// cgc-bind varying cg_TEXCOORD0 TEXCOORD0
// cgc-bind uniform tint
// cgc-bind builtin gl_FragColor COLOR0

struct FragmentOut
{
    vec4 color;
};

varying vec2 cg_TEXCOORD0;
uniform vec4 tint;

void main()
{
    vec2 texcoord;
    FragmentOut cg_output;
    texcoord = cg_TEXCOORD0;
    if (texcoord.x < 0.0)
    {
        discard;
    }
    if (texcoord.y > 1.0)
    {
        cg_output.color = tint;
    }
    else
    {
        cg_output.color = tint * texcoord.y;
    }
    gl_FragColor = cg_output.color;
}
