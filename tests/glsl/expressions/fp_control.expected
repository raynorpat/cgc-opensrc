#version 150
// cgc-bind input cg_TEXCOORD0 TEXCOORD0
// cgc-bind output cg_COLOR0 COLOR0
// cgc-bind uniform tint

struct FragmentOut
{
    vec4 color;
};

in vec2 cg_TEXCOORD0;
out vec4 cg_COLOR0;
uniform vec4 tint;

void main()
{
    vec2 texcoord;
    FragmentOut cg_output;
    texcoord = cg_TEXCOORD0;
    if (texcoord.x < 0.0)
    {
        discard;
    }
    if (texcoord.y > 1.0)
    {
        cg_output.color = tint;
    }
    else
    {
        cg_output.color = tint * texcoord.y;
    }
    cg_COLOR0 = cg_output.color;
}
