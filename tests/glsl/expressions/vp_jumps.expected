#version 150
// cgc-bind input cg_ATTRIB0 ATTRIB0
// cgc-bind builtin gl_Position POSITION0

struct VertexOut
{
    vec4 position;
};

in vec4 cg_ATTRIB0;

void main()
{
    vec4 position;
    VertexOut cg_output;
    int index;
    position = cg_ATTRIB0;
    for (index = 0; index < 4; index = index + 1)
    {
        if (index == 1)
        {
            continue;
        }
        if (index == 3)
        {
            break;
        }
        position.x = position.x + 1.0;
    }
    cg_output.position = position;
    gl_Position = cg_output.position;
}
