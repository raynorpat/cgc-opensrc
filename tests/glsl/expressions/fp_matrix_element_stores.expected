#version 150
// cgc-bind input cg_COLOR0 COLOR0
// cgc-bind output cg_COLOR0_1 COLOR0
// cgc-bind uniform source

struct FragmentOut
{
    vec4 color;
};

in vec4 cg_COLOR0;
out vec4 cg_COLOR0_1;
uniform mat3 source;

void main()
{
    vec4 color;
    FragmentOut cg_output;
    mat3 mixed;
    mat4 fill;
    color = cg_COLOR0;
    mixed[0][0] = source[0][0];
    mixed[1][0] = source[0][1];
    mixed[0][2] = source[2][0];
    fill[0][0] = 1.0;
    fill[1][0] = 2.0;
    fill[2][0] = 3.0;
    fill[3][0] = 4.0;
    fill[0][1] = 5.0;
    fill[1][1] = 6.0;
    fill[2][1] = 7.0;
    fill[3][1] = 8.0;
    fill[0][2] = 9.0;
    fill[1][2] = 10.0;
    fill[2][2] = 11.0;
    fill[3][2] = 12.0;
    fill[0][3] = 13.0;
    fill[1][3] = 14.0;
    fill[2][3] = 15.0;
    fill[3][3] = 16.0;
    cg_output.color = color + vec4(mixed[0][0] + fill[3][3], mixed[1][0] - fill[0][0], mixed[0][2] * 0.5 + fill[1][2], fill[2][1] * 0.0);
    cg_COLOR0_1 = cg_output.color;
}
