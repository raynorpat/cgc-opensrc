#version 150
// cgc-bind input cg_ATTRIB0 ATTRIB0
// cgc-bind builtin gl_Position POSITION0

struct VertexOut
{
    vec4 position;
};

in vec4 cg_ATTRIB0;

float normalize(float value, float scale)
{
    return value * scale;
}

void main()
{
    vec4 position;
    VertexOut result;
    position = cg_ATTRIB0;
    result.position = position;
    result.position.x = normalize(position.x, 2.0);
    gl_Position = result.position;
}
