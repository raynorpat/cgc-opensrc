#version 150
// cgc-bind input cg_ATTRIB0 ATTRIB0
// cgc-bind builtin gl_Position POSITION0

struct VertexOut
{
    vec4 position;
};

in vec4 cg_ATTRIB0;

void main()
{
    vec4 position;
    VertexOut cg_output;
    float value;
    float scalar;
    vec3 repeated;
    position = cg_ATTRIB0;
    value = float(position.x);
    scalar = value;
    repeated = vec3(value);
    position.x = scalar + repeated.x;
    cg_output.position = position;
    gl_Position = cg_output.position;
}
