#version 150
// cgc-bind input cg_TEXCOORD0 TEXCOORD0
// cgc-bind output cg_COLOR0 COLOR0
// cgc-bind builtin gl_FragDepth DEPTH0

struct FragmentOut
{
    vec4 color;
    float depth;
};

in vec4 cg_TEXCOORD0;
out vec4 cg_COLOR0;

FragmentOut makeOutput(vec4 color, float state)
{
    FragmentOut cg_output;
    cg_output.color = color * state;
    cg_output.depth = state;
    return cg_output;
}

void main()
{
    vec4 color;
    float cg_return;
    FragmentOut cg_return1;
    color = cg_TEXCOORD0;
    cg_return = 0.5;
    cg_return1 = makeOutput(color, cg_return);
    cg_COLOR0 = cg_return1.color;
    gl_FragDepth = cg_return1.depth;
}
