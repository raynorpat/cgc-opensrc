#version 110
// cgc-bind varying cg_TEXCOORD0 TEXCOORD0
// cgc-bind builtin gl_FragColor COLOR0
// cgc-bind builtin gl_FragDepth DEPTH0

struct FragmentOut
{
    vec4 color;
    float depth;
};

varying vec4 cg_TEXCOORD0;

FragmentOut makeOutput(vec4 color, float state)
{
    FragmentOut cg_output;
    cg_output.color = color * state;
    cg_output.depth = state;
    return cg_output;
}

void main()
{
    vec4 color;
    float cg_return;
    FragmentOut cg_return1;
    color = cg_TEXCOORD0;
    cg_return = 0.5;
    cg_return1 = makeOutput(color, cg_return);
    gl_FragColor = cg_return1.color;
    gl_FragDepth = cg_return1.depth;
}
