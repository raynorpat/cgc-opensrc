#version 150
// cgc-bind input cg_TEXCOORD0 TEXCOORD0
// cgc-bind output cg_COLOR0 COLOR0

struct FragmentOut
{
    vec4 color;
};

in vec2 cg_TEXCOORD0;
out vec4 cg_COLOR0;

vec4 shade(vec2 texcoord)
{
    if (texcoord.x < 0.0)
    {
        if (texcoord.y < 0.0)
        {
            discard;
        }
    }
    if (texcoord.y > 1.0)
    {
        return vec4(1.0, 1.0, 1.0, 1.0);
    }
    return vec4(texcoord.x, texcoord.y, 0.0, 1.0);
}

void main()
{
    vec2 texcoord;
    FragmentOut cg_output;
    texcoord = cg_TEXCOORD0;
    cg_output.color = shade(texcoord);
    cg_COLOR0 = cg_output.color;
}
