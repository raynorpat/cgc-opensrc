#version 150
// cgc-bind input cg_COLOR0 COLOR0
// cgc-bind output cg_COLOR0_1 COLOR0
// cgc-bind builtin gl_FrontFacing FACE0

struct FragmentOut
{
    vec4 color;
};

in vec4 cg_COLOR0;
out vec4 cg_COLOR0_1;

void main()
{
    vec4 color;
    bool front;
    FragmentOut cg_output;
    color = cg_COLOR0;
    front = gl_FrontFacing;
    cg_output.color = color;
    if (front)
    {
        if (color.x > 0.5)
        {
            cg_output.color = vec4(1.0, 1.0, 1.0, 1.0);
            cg_COLOR0_1 = cg_output.color;
            return;
        }
        cg_output.color = vec4(0.5, 0.5, 0.5, 1.0);
    }
    cg_output.color = vec4(0.0, 0.0, 0.0, 1.0);
    cg_COLOR0_1 = cg_output.color;
}
