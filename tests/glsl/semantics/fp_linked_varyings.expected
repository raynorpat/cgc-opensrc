#version 110
// cgc-bind varying cg_COLOR0 COLOR0
// cgc-bind varying cg_TEXCOORD0 TEXCOORD0
// cgc-bind varying cg_TEXCOORD1 TEXCOORD1
// cgc-bind builtin gl_FragColor COLOR0

struct FragmentOut
{
    vec4 color;
};

varying vec4 cg_COLOR0;
varying vec4 cg_TEXCOORD0;
varying vec4 cg_TEXCOORD1;

void main()
{
    vec4 color;
    vec4 texcoord;
    vec4 auxiliary;
    FragmentOut cg_output;
    color = cg_COLOR0;
    texcoord = cg_TEXCOORD0;
    auxiliary = cg_TEXCOORD1;
    cg_output.color = color + texcoord + auxiliary;
    gl_FragColor = cg_output.color;
}
