#version 150
// cgc-bind input cg_COLOR0 COLOR0
// cgc-bind input cg_TEXCOORD0 TEXCOORD0
// cgc-bind input cg_TEXCOORD1 TEXCOORD1
// cgc-bind output cg_COLOR0_1 COLOR0

struct FragmentOut
{
    vec4 color;
};

in vec4 cg_COLOR0;
in vec4 cg_TEXCOORD0;
in vec4 cg_TEXCOORD1;
out vec4 cg_COLOR0_1;

void main()
{
    vec4 color;
    vec4 texcoord;
    vec4 auxiliary;
    FragmentOut cg_output;
    color = cg_COLOR0;
    texcoord = cg_TEXCOORD0;
    auxiliary = cg_TEXCOORD1;
    cg_output.color = color + texcoord + auxiliary;
    cg_COLOR0_1 = cg_output.color;
}
