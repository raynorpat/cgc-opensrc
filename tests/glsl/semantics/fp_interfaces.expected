#version 150
// cgc-bind input cg_COLOR0 COLOR0
// cgc-bind input cg_TEXCOORD1 TEXCOORD1
// cgc-bind input cg_FOG0 FOG0
// cgc-bind output cg_COLOR0_1 COLOR0
// cgc-bind builtin gl_FragCoord POSITION0

struct FragmentOut
{
    vec4 color;
};

in vec4 cg_COLOR0;
in vec2 cg_TEXCOORD1;
in float cg_FOG0;
out vec4 cg_COLOR0_1;

void main()
{
    vec4 diffuse;
    vec2 texcoord;
    float fog;
    vec4 position;
    FragmentOut cg_output;
    diffuse = cg_COLOR0;
    texcoord = cg_TEXCOORD1;
    fog = cg_FOG0;
    position = gl_FragCoord;
    cg_output.color = diffuse + vec4(texcoord.x, texcoord.y, fog, position.w);
    cg_COLOR0_1 = cg_output.color;
}
