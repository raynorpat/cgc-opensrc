#version 110
// cgc-bind varying cg_COLOR0 COLOR0
// cgc-bind varying cg_TEXCOORD1 TEXCOORD1
// cgc-bind varying cg_FOG0 FOG0
// cgc-bind builtin gl_FragCoord POSITION0
// cgc-bind builtin gl_FragColor COLOR0

struct FragmentOut
{
    vec4 color;
};

varying vec4 cg_COLOR0;
varying vec2 cg_TEXCOORD1;
varying float cg_FOG0;

void main()
{
    vec4 diffuse;
    vec2 texcoord;
    float fog;
    vec4 position;
    FragmentOut cg_output;
    diffuse = cg_COLOR0;
    texcoord = cg_TEXCOORD1;
    fog = cg_FOG0;
    position = gl_FragCoord;
    cg_output.color = diffuse + vec4(texcoord.x, texcoord.y, fog, position.w);
    gl_FragColor = cg_output.color;
}
