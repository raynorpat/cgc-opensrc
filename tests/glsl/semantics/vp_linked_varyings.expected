#version 110
// cgc-bind attribute cg_POSITION0 POSITION0
// cgc-bind attribute cg_COLOR0_2 COLOR0
// cgc-bind attribute cg_TEXCOORD0_2 TEXCOORD0
// cgc-bind varying cg_COLOR0 COLOR0
// cgc-bind varying cg_TEXCOORD0 TEXCOORD0
// cgc-bind varying cg_TEXCOORD1 TEXCOORD1
// cgc-bind uniform cg_TEXCOORD0_1
// cgc-bind builtin gl_Position POSITION0

struct cg_COLOR0_1
{
    vec4 value;
};

struct VertexOut
{
    vec4 position;
    vec4 color;
    vec4 texcoord;
    vec4 auxiliary;
};

attribute vec4 cg_POSITION0;
attribute vec4 cg_COLOR0_2;
attribute vec4 cg_TEXCOORD0_2;
varying vec4 cg_COLOR0;
varying vec4 cg_TEXCOORD0;
varying vec4 cg_TEXCOORD1;
uniform vec4 cg_TEXCOORD0_1;

void main()
{
    vec4 position;
    vec4 color;
    vec4 texcoord;
    cg_COLOR0_1 holder;
    vec4 cg_TEXCOORD1_1;
    VertexOut cg_output;
    position = cg_POSITION0;
    color = cg_COLOR0_2;
    texcoord = cg_TEXCOORD0_2;
    holder.value = color;
    cg_TEXCOORD1_1 = texcoord + cg_TEXCOORD0_1;
    cg_output.position = position;
    cg_output.color = holder.value;
    cg_output.texcoord = texcoord;
    cg_output.auxiliary = cg_TEXCOORD1_1;
    gl_Position = cg_output.position;
    cg_COLOR0 = cg_output.color;
    cg_TEXCOORD0 = cg_output.texcoord;
    cg_TEXCOORD1 = cg_output.auxiliary;
}
