#version 150
// cgc-bind input cg_ATTRIB0 ATTRIB0
// cgc-bind uniform cg_output
// cgc-bind builtin gl_Position POSITION0

struct cg_gl_Data
{
    vec4 cg_gl_value_1;
    vec4 cg_gl_value;
};

struct VertexOut
{
    vec4 position;
};

in vec4 cg_ATTRIB0;
uniform cg_gl_Data cg_output;

void main()
{
    vec4 position;
    VertexOut result;
    position = cg_ATTRIB0;
    result.position = position + cg_output.cg_gl_value_1 + cg_output.cg_gl_value;
    gl_Position = result.position;
}
