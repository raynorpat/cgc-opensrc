#version 150
// cgc-bind input cg_TEXCOORD0 TEXCOORD0
// cgc-bind output cg_COLOR0 COLOR0
// cgc-bind uniform values

struct FragmentOut
{
    vec4 color;
};

in vec2 cg_TEXCOORD0;
out vec4 cg_COLOR0;
uniform vec4 values[16];

void main()
{
    vec2 texcoord;
    FragmentOut cg_output;
    texcoord = cg_TEXCOORD0;
    cg_output.color = values[0] + values[15] + vec4(texcoord.x, texcoord.y, 0.0, 0.0);
    cg_COLOR0 = cg_output.color;
}
