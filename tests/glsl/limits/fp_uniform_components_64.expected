#version 110
// cgc-bind varying cg_TEXCOORD0 TEXCOORD0
// cgc-bind uniform values
// cgc-bind builtin gl_FragColor COLOR0

struct FragmentOut
{
    vec4 color;
};

varying vec2 cg_TEXCOORD0;
uniform vec4 values[16];

void main()
{
    vec2 texcoord;
    FragmentOut cg_output;
    texcoord = cg_TEXCOORD0;
    cg_output.color = values[0] + values[15] + vec4(texcoord.x, texcoord.y, 0.0, 0.0);
    gl_FragColor = cg_output.color;
}
