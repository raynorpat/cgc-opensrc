#version 150
layout(points) in;
layout(points, max_vertices = 1) out;

// cgc-bind input cg_TEXCOORD0 TEXCOORD0
// cgc-bind uniform scale
// cgc-bind sampler image 0

in vec2 cg_TEXCOORD0[1];
uniform float scale;
uniform sampler2D image;

void main()
{
    vec4 sampled;
    sampled = texture(image, cg_TEXCOORD0[0]);
    gl_Position = gl_in[0].gl_Position + sampled * scale;
    EmitVertex();
}
