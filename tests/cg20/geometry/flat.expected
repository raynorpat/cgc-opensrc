# Generic output by Cg compiler
//vendor NVIDIA Corporation
//version 1.0.1
//profile generic
//program main
//semantic state
//var float4 state.tint :  :  : -1 : 1
// *** unknown category 0x00000080 ***
module main stage geometry
geometry input triangle vertices 3
geometry output triangle_strip max_vertices 6
uniform struct FlatState state;

void main(varying AttribArray<float4,3> p : POSITION)
{
  flat_attribute {
    COLOR0 = %state.tint
  }
  flat_attribute {
    COLOR0 = %state.tint * (float)0.500000
  }
  emit_vertex {
    POSITION = %p[0]
    TEXCOORD0 = %p[1]
  }
  restart_strip
}
