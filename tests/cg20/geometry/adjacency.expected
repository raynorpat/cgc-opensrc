# Generic output by Cg compiler
//vendor NVIDIA Corporation
//version 1.0.1
//profile generic
//program main
// *** unknown category 0x00000080 ***
module main stage geometry
geometry input line_adjacency vertices 4
geometry output line_strip max_vertices 4
void main(varying AttribArray<float4,4> p : POSITION)
{
  emit_vertex {
    POSITION = %(p[1] + p[2]) * (float)0.500000
  }
  emit_vertex {
    POSITION = %p[2] - p[1]
  }
  restart_strip
}
