//version 1.0.1
//profile generic
//program line_adj_default
//var float4 p : $vin.POSITION : POSITION : 0 : 1
module line_adj_default stage geometry
geometry input line_adjacency vertices 4
geometry output line_strip max_vertices unknown
uniform struct $vin $vin;

void line_adj_default(varying float4 p : POSITION)
{
  float4 c;
  p = $vin.POSITION;
  c = p;
}
