// Task 2 fixture: every input and output topology modifier parses at
// declaration-specifier position.  The parameter spelling AttribArray<T>
// is introduced by the attribute-array task.

POINT void point_main(AttribArray<float4> p : POSITION) { return; }
LINE LINE_OUT void line_main(AttribArray<float4> p : POSITION) { return; }
LINE_ADJ void line_adj_main(AttribArray<float4> p : POSITION) { return; }
TRIANGLE POINT_OUT void triangle_main(AttribArray<float4> p : POSITION) { return; }
TRIANGLE_ADJ TRIANGLE_OUT void triangle_adj_main(
    AttribArray<float4> p : POSITION) { return; }
