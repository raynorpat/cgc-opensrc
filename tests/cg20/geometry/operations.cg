// Task 4 fixture: all three geometry operations in one triangle entry
// plus a reachable helper that emits on its own.  The helper takes a
// plain value: only the selected entry may carry topology modifiers
// or attribute-array parameters.

void emit_helper(float4 v)
{
    emitVertex(v : POSITION);
}

TRIANGLE void operation_main(AttribArray<float4> p : POSITION,
                             uniform float4 flatColor)
{
    flatAttrib(flatColor : COLOR0);
    emit_helper(p[0]);
    emitVertex(p[0] : POSITION);
    restartStrip();
}
