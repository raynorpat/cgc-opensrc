float sum(float values[])
{
    float result = 0.0;
    int i;
    for (i = 0; i < values.length; ++i)
        result += values[i];
    return result;
}

float4 main(float4 p : POSITION) : POSITION
{
    float source[3] = { 1.0, 2.0, 3.0 };
    float dynamic[];
    dynamic = source;
    return p + sum(dynamic) * 0.0;
}
