// Cg 2.0 standard-library numeric intrinsics (Task 13).
//
// Calls every ordinary non-texture catalog name at least once using a
// minimal documented signature.  Compiled through the generic profile;
// resolution goes through the declarative catalog installed by
// cg_stdlib.def/cg_stdlib.c.

uniform float3x3 matA;
uniform float3x3 matB;

struct NumericOut
{
    float4 value : POSITION;
};

NumericOut main(float4 position : ATTRIB0)
{
    NumericOut result;

    float  a = position.x;
    float  b = position.y * 0.5 + 0.25;
    float3 u = float3(position.x, position.y, position.z);
    float3 w = float3(position.w, position.y, position.x);
    float2 p = float2(position.x, position.y);
    bool flag = position.x > position.y;

    // abs, fmod, min, max, pow, ldexp, step over replicated shapes
    a = abs(-a);
    b = fmod(b, a);
    a = min(a, b);
    a = max(a, b);
    a = pow(a, b);
    a = ldexp(a, 2);

    // trigonometric and exponential families
    a = sin(a) + cos(b) + tan(a * b);
    a = asin(clamp(a, 0.0, 1.0)) + acos(clamp(b, 0.0, 1.0));
    a = atan(a) + atan2(b, a);
    a = sinh(a) + cosh(b) + tanh(a);
    a = exp(a) + exp2(b) + log(a + 2.0) + log2(b + 1.0)
      + log10(b + 10.0);
    a = sqrt(abs(a)) + rsqrt(abs(b) + 1.0);
    a = floor(b) + ceil(a) + round(b) + frac(a);
    a = degrees(a) + radians(b);
    a = saturate(a) + sign(b);

    // classification predicates
    if (isfinite(a) && !isinf(b) && !isnan(a))
        flag = true;

    // boolean reductions
    flag = all(flag) || any(flag);

    // interpolation and stepping
    a = lerp(a, b, 0.5);
    a = smoothstep(0.0, 1.0, a);
    a = step(a, b);
    a = clamp(a, 0.0, 1.0);

    // geometric helpers on vectors
    a = dot(u, w) + length(u) + distance(p, p);
    u = normalize(w);
    u = cross(u, w);
    u = reflect(u, w);
    u = refract(u, w, 0.75);
    u = faceforward(u, w, u);

    // matrix products, transpose, and determinant
    u = mul(matA, w);
    w = mul(u, matB);
    float3x3 mm = mul(matA, matB);
    w = mul(w, mm);
    float3x3 t = transpose(matB);
    a = a + determinant(t);

    // lit packs shading coefficients into a float4
    float4 litResult = lit(a, b, 2.0);
    a = a + litResult.x;

    // derivatives
    a = ddx(a) + ddy(b);
    p = ddx(p) + ddy(p);

    // noise over the documented float2 domain
    a = a + noise(p);

    result.value = float4(a + u.x, b + u.y, a + u.z, dot(p, p));
    return result;
}
