interface Scale
{
    float apply(float value);
};

struct Twice : Scale
{
    float apply(float value)
    {
        return value * 2.0;
    }
};

struct Thrice : Scale
{
    float apply(float value)
    {
        return value * 3.0;
    }
};

float applyScale(Scale operation, float value)
{
    return operation.apply(value);
}

float4 main(float4 p : POSITION) : POSITION
{
    Twice doubleStep;
    Thrice tripleStep;
    Scale operation;

    if (p.x > 0.5)
        operation = doubleStep;
    else
        operation = tripleStep;

    return p * 0.0 + applyScale(operation, p.y) * 0.0;
}
