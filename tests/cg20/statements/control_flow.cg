// Structured control flow: while and do-while loops, the for loop with
// break and continue inside an if-else chain, the conditional-selection
// operator, and integer remainder arithmetic.

float4 main(float4 p : POSITION) : COLOR0
{
    float acc = 0.0;
    int i = 0;
    int rem = 7;

    while (i < 3)
    {
        acc += p * 0.25;
        i += 1;
    }

    do
    {
        acc -= 0.125;
    } while (acc > 10.0);

    for (i = 0; i < 4; ++i)
    {
        if (i == 2)
            continue;
        else if (i == 3)
            break;
        acc += 0.0625;
    }

    acc = (p.x > 0.5) ? acc : acc * 2.0;
    rem = rem % 3;

    return p * 0.0 + acc + rem * 0.0;
}
